---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const sorted = allPosts.sort((a, b) => b.data.pubDate?.valueOf() - a.data.pubDate?.valueOf());

const searchIndex = sorted.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: (p.data.description || "").slice(0, 220),
  category: p.data.category || "",
  date: p.data.pubDate ? p.data.pubDate.toISOString().slice(0, 10) : "",
}));

const categoryLabel: Record<string, string> = {
  operaciones: "Operaciones",
  cumplimiento: "Cumplimiento",
  fiscalidad: "Fiscalidad",
  vehiculos: "Vehículos",
  "tarjetas-gasoil": "Tarjetas de Gasoil",
  actualidad: "Actualidad",
};
---

<BaseLayout
  pageBg="categorias"
  title="Buscar en el blog | AdmiLogistic"
  description="Busca artículos sobre transporte, tacógrafo, fiscalidad y logística en el blog de AdmiLogistic."
>
  <section class="search-page">
    <div class="search-page-inner">
      <h1>Buscar artículos</h1>

      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
        <input
          type="search"
          id="search-input"
          placeholder="Escribe para buscar..."
          aria-label="Buscar artículos"
          autocomplete="off"
          autofocus
        />
        <button id="search-clear" class="search-clear" aria-label="Limpiar búsqueda" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <p id="search-count" class="search-count" aria-live="polite"></p>

      <ul id="search-results" class="search-results" role="list"></ul>

      <p id="search-empty" class="search-empty" hidden>No se han encontrado artículos para tu búsqueda.</p>
      <p id="search-hint" class="search-hint">Escribe al menos 2 caracteres para buscar entre {allPosts.length} artículos.</p>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ searchIndex, categoryLabel }}>
  (function () {
    const input = document.getElementById("search-input");
    const resultsList = document.getElementById("search-results");
    const emptyMsg = document.getElementById("search-empty");
    const hint = document.getElementById("search-hint");
    const countEl = document.getElementById("search-count");
    const clearBtn = document.getElementById("search-clear");

    function escapeHtml(s) {
      const d = document.createElement("div");
      d.textContent = s;
      return d.innerHTML;
    }

    function highlight(text, q) {
      if (!q) return escapeHtml(text);
      const escaped = escapeHtml(text);
      const escapedQ = q.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      return escaped.replace(new RegExp("(" + escapedQ + ")", "gi"), "<mark>$1</mark>");
    }

    function render(items, q) {
      resultsList.innerHTML = "";
      emptyMsg.hidden = true;
      hint.hidden = true;
      countEl.textContent = "";

      if (!q || q.length < 2) {
        hint.hidden = false;
        return;
      }

      if (!items.length) {
        emptyMsg.hidden = false;
        return;
      }

      countEl.textContent = items.length === 1
        ? "1 artículo encontrado"
        : items.length + " artículos encontrados";

      resultsList.innerHTML = items.map(function (p) {
        const cat = categoryLabel[p.category] || p.category;
        return (
          '<li class="search-result-item">' +
          '<a href="/blog/' + escapeHtml(p.id) + '/" class="search-result-link">' +
          (cat ? '<span class="result-cat">' + escapeHtml(cat) + "</span>" : "") +
          '<h2 class="result-title">' + highlight(p.title, q) + "</h2>" +
          (p.description
            ? '<p class="result-desc">' + highlight(p.description, q) + "</p>"
            : "") +
          (p.date ? '<span class="result-date">' + p.date + "</span>" : "") +
          "</a>" +
          "</li>"
        );
      }).join("");
    }

    function runSearch(q) {
      q = (q || "").trim().toLowerCase();
      const filtered = q.length < 2 ? [] : searchIndex.filter(function (p) {
        return (
          p.title.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.category.toLowerCase().includes(q)
        );
      });
      render(filtered, q);
      clearBtn.hidden = !input.value;

      // actualizar URL sin recargar
      const url = new URL(window.location.href);
      if (input.value.trim()) {
        url.searchParams.set("q", input.value.trim());
      } else {
        url.searchParams.delete("q");
      }
      history.replaceState(null, "", url.toString());
    }

    input.addEventListener("input", function () {
      runSearch(input.value);
    });

    clearBtn.addEventListener("click", function () {
      input.value = "";
      input.focus();
      runSearch("");
    });

    // cargar query inicial desde URL
    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get("q") || "";
    if (initialQ) {
      input.value = initialQ;
      runSearch(initialQ);
    }
  })();
</script>

<style>
  .search-page {
    min-height: 70vh;
    padding: 3rem 1rem 5rem;
  }

  .search-page-inner {
    max-width: 780px;
    margin: 0 auto;
  }

  h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 700;
    color: var(--text-primary, #111);
    margin-bottom: 1.75rem;
  }

  .search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    width: 20px;
    height: 20px;
    color: #888;
    pointer-events: none;
    flex-shrink: 0;
  }

  #search-input {
    width: 100%;
    padding: 0.9rem 3rem 0.9rem 2.75rem;
    font-size: 1.0625rem;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    background: #fff;
    transition: border-color 0.2s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  #search-input:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.12);
  }

  .search-clear {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    color: #888;
    display: flex;
    align-items: center;
  }

  .search-clear svg {
    width: 18px;
    height: 18px;
  }

  .search-count {
    font-size: 0.875rem;
    color: #666;
    margin-bottom: 1.25rem;
    min-height: 1.2em;
  }

  .search-hint,
  .search-empty {
    color: #777;
    font-size: 0.9375rem;
    margin-top: 2rem;
  }

  .search-results {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-result-item {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .search-result-item:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,0.1);
    transform: translateY(-2px);
  }

  .search-result-link {
    display: block;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  .result-cat {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #6366f1;
    margin-bottom: 0.35rem;
  }

  .result-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    color: #111;
    margin: 0 0 0.4rem;
  }

  .result-desc {
    font-size: 0.875rem;
    color: #555;
    line-height: 1.5;
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .result-date {
    font-size: 0.75rem;
    color: #999;
  }

  mark {
    background: #fef08a;
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
</style>
