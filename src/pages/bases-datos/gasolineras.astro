---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout pageBg="bases" title="Base de Datos - Gasolineras | AdmiLogistic" description="Mapa de áreas de servicio y gasolineras en las principales vías.">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <div class="db-page">
    <header class="db-header">
      <h1>Gasolineras y áreas de servicio</h1>
      <p>Áreas de servicio en autopistas y vías principales. Datos de carácter orientativo (OpenStreetMap).</p>
    </header>
    <div class="db-map-wrap">
      <div id="map-gasolineras" class="db-map">
        <p class="db-map-loading" id="map-gasolineras-loading">Cargando gasolineras…</p>
      </div>
    </div>
    <div class="db-cta">
      <a href="/proyectos/roadmaster" class="db-cta-btn">Usar gasolineras en RoadMaster</a>
    </div>
  </div>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      function init() {
        if (typeof L === 'undefined') {
          setTimeout(init, 50);
          return;
        }
        const mapEl = document.getElementById('map-gasolineras');
        if (!mapEl) return;
        const map = L.map('map-gasolineras').setView([40.4, -3.7], 6);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);
        fetch('/data/gasolineras.geojson')
          .then(function (r) {
            if (!r.ok) throw new Error('No se pudo cargar el archivo');
            return r.json();
          })
          .then(function (geojson) {
            var loadingEl = document.getElementById('map-gasolineras-loading');
            if (loadingEl) loadingEl.classList.add('hidden');
            var features = (geojson && geojson.features) || [];
            if (features.length === 0) return;
            var maxPoints = 3000;
            var toUse = features.length <= maxPoints ? geojson : { type: 'FeatureCollection', features: features.slice(0, maxPoints) };
            var layer = L.geoJSON(toUse, {
              pointToLayer: function (f, latlng) {
                return L.circleMarker(latlng, {
                  radius: 6,
                  fillColor: '#22c55e',
                  color: '#16a34a',
                  weight: 1,
                  fillOpacity: 0.85
                });
              },
              onEachFeature: function (f, layer) {
                var name = (f.properties && f.properties.name) || 'Área de servicio';
                layer.bindPopup(name);
              }
            });
            layer.addTo(map);
            map.invalidateSize();
            try {
              var b = layer.getBounds();
              if (b && b.isValid()) map.fitBounds(b, { padding: [40, 40], maxZoom: 10 });
            } catch (e) {}
          })
          .catch(function () {
            var loadingEl = document.getElementById('map-gasolineras-loading');
            if (loadingEl) {
              loadingEl.classList.add('hidden');
              loadingEl.outerHTML = '<p class="db-map-loading" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);margin:0;color:#64748b;">No se pudieron cargar los datos. Comprueba que existe <code>public/data/gasolineras.geojson</code>.</p>';
            }
          });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</BaseLayout>

<style>
  .db-page { max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  .db-header { text-align: center; margin-bottom: 1.5rem; }
  .db-header h1 { font-size: clamp(1.75rem, 3vw, 2.25rem); color: #1a1a1a; margin-bottom: 0.5rem; }
  .db-header p { color: #555; font-size: 1rem; line-height: 1.6; }
  .db-map-wrap { margin-bottom: 2rem; border-radius: 16px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.12); border: 1px solid rgba(0,0,0,0.08); }
  .db-map { height: 480px; background: #e5e7eb; position: relative; }
  .db-map-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    color: #64748b;
    font-size: 1rem;
    z-index: 1000;
  }
  .db-map-loading.hidden { display: none; }
  .db-cta { text-align: center; margin-top: 2rem; }
  .db-cta-btn { display: inline-block; padding: 0.75rem 1.75rem; background: #22c55e; color: #fff; font-weight: 600; text-decoration: none; border-radius: 10px; transition: background 0.2s; }
  .db-cta-btn:hover { background: #16a34a; }
  @media (max-width: 768px) { .db-map { height: 360px; } }
</style>
