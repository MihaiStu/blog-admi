---
import BaseLayout from '../../layouts/BaseLayout.astro';
import datos from '../../data/talleres-provincias.json';

const provincias = datos.provincias;
const total = datos.totalTalleres;

const title = `Talleres mecánicos para camiones en España — ${total} talleres por provincia | AdmiLogistic`;
const description = `Mapa y listado de ${total} talleres mecánicos para camiones en España, organizados por provincia.`;

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Talleres mecánicos para camiones en España",
  description,
  numberOfItems: total,
  itemListElement: provincias.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: `${p.provincia} — ${p.numTalleres} talleres`,
    url: `https://admilogistic.es/bases-datos/talleres/${p.slug}/`,
  })),
};
---

<BaseLayout pageBg="bases" title={title} description={description}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  </Fragment>
  <div class="pk-idx">
    <header class="pk-idx-header">
      <h1>Talleres mecánicos para camiones</h1>
      <p>
        <strong>{total} talleres</strong> especializados en vehículos industriales en toda España.
        {provincias.filter(p => p.numUrgencias24h > 0).length} provincias con talleres de urgencia 24h.
        Datos de RoadMaster.
      </p>
    </header>

    <div class="pk-idx-stats">
      <div class="pk-idx-stat">
        <span class="v">{total}</span>
        <span class="l">Talleres totales</span>
      </div>
      <div class="pk-idx-stat">
        <span class="v">{provincias.reduce((a, p) => a + p.numUrgencias24h, 0)}</span>
        <span class="l">Urgencias 24h</span>
      </div>
      <div class="pk-idx-stat">
        <span class="v">{provincias.reduce((a, p) => a + p.numConTelefono, 0)}</span>
        <span class="l">Con teléfono</span>
      </div>
      <div class="pk-idx-stat">
        <span class="v">{provincias.length}</span>
        <span class="l">Provincias</span>
      </div>
    </div>

    <h2>Elige tu provincia</h2>
    <div class="pk-idx-grid">
      {provincias.map((p) => (
        <a href={`/bases-datos/talleres/${p.slug}/`} class="pk-idx-card">
          <span class="pk-idx-prov">{p.provincia}</span>
          <span class="pk-idx-meta">
            {p.numTalleres} talleres
            {p.especialidades.length > 0 && ` · ${p.especialidades.slice(0, 3).join(', ')}${p.especialidades.length > 3 ? '...' : ''}`}
          </span>
          {p.numUrgencias24h > 0 && (
            <span class="pk-idx-badge">24h</span>
          )}
        </a>
      ))}
    </div>

    <p class="pk-idx-nota">
      Datos recopilados de RoadMaster. Incluye talleres especializados en mecánica, chapa, neumáticos,
      ITV, electricidad, motor y grúa para vehículos industriales.
    </p>

    <div class="pk-idx-cta">
      <a href="/proyectos/roadmaster/" class="pk-idx-cta-btn">Gestiona tu flota con RoadMaster →</a>
    </div>
  </div>

  <div class="pk-map-wrap">
    <div id="pk-map" class="pk-map"></div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
</BaseLayout>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  (function () {
    const mapEl = document.getElementById('pk-map');
    if (!mapEl) return;
    fetch('/data/talleres.json')
      .then(r => r.json())
      .then(data => {
        if (typeof L === 'undefined') return;
        const map = L.map('pk-map').setView([40.4, -3.7], 6);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OpenStreetMap'
        }).addTo(map);
        const bounds = [];
        data.forEach(t => {
          if (t.lat == null || t.lng == null) return;
          bounds.push([t.lat, t.lng]);
          const urg = t.urgencias24h ? ' · 24h' : '';
          L.marker([t.lat, t.lng])
            .addTo(map)
            .bindPopup(`<strong>${escHtml(t.nombre)}</strong><br>${escHtml(t.provincia)}${urg}`);
        });
        if (bounds.length) map.fitBounds(bounds, { padding: [30, 30], maxZoom: 10 });
      })
      .catch(() => {});
    function escHtml(s) {
      if (!s) return '';
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }
  })();
</script>

<style>
  .pk-idx { max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem 1rem; }
  .pk-idx-header { text-align: center; margin-bottom: 1.5rem; }
  .pk-idx-header h1 { font-size: clamp(1.75rem, 3vw, 2.4rem); color: #fff; margin-bottom: 0.6rem; text-shadow: 1px 1px 3px rgba(0,0,0,0.4); }
  .pk-idx-header p { color: rgba(255,255,255,0.9); font-size: 1.05rem; line-height: 1.6; max-width: 780px; margin: 0 auto; }
  .pk-idx-header strong { color: #fff; }

  .pk-idx-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 1.75rem auto; max-width: 720px; }
  .pk-idx-stat { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); border-radius: 12px; padding: 1rem; text-align: center; }
  .pk-idx-stat .v { display: block; font-size: 1.3rem; font-weight: 700; color: #fff; }
  .pk-idx-stat .l { display: block; font-size: 0.78rem; color: rgba(255,255,255,0.72); margin-top: 0.3rem; }

  .pk-idx h2 { color: #fff; font-size: 1.35rem; margin: 1.5rem 0 1rem; text-align: center; text-shadow: 1px 1px 3px rgba(0,0,0,0.4); }

  .pk-idx-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.9rem; }
  .pk-idx-card { position: relative; display: flex; flex-direction: column; gap: 0.25rem; padding: 1rem 1.1rem; background: rgba(15,23,42,0.55); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); border-left: 4px solid #3b82f6; border-radius: 12px; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s, background 0.2s; }
  .pk-idx-card:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0,0,0,0.3); background: rgba(15,23,42,0.7); }
  .pk-idx-prov { font-weight: 700; color: #ffffff; font-size: 1.05rem; text-shadow: 1px 1px 3px rgba(0,0,0,0.5); }
  .pk-idx-meta { color: rgba(255,255,255,0.75); font-size: 0.8rem; }
  .pk-idx-badge { position: absolute; top: 0.5rem; right: 0.5rem; font-size: 0.65rem; background: #ef4444; color: #fff; padding: 0.15rem 0.5rem; border-radius: 999px; font-weight: 600; }

  .pk-idx-nota { font-size: 0.8rem; color: rgba(255,255,255,0.65); margin-top: 1.25rem; text-align: center; line-height: 1.5; }
  .pk-idx-nota a { color: #60a5fa; text-decoration: underline; }
  .pk-idx-cta { text-align: center; margin-top: 1.5rem; }
  .pk-idx-cta-btn { display: inline-block; padding: 0.8rem 1.9rem; background: #3b82f6; color: #fff; font-weight: 700; text-decoration: none; border-radius: 10px; transition: background 0.2s; }
  .pk-idx-cta-btn:hover { background: #60a5fa; }

  .pk-map-wrap { max-width: 1200px; margin: 2rem auto; padding: 0 1rem 3rem; }
  .pk-map { height: 420px; border-radius: 16px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.12); border: 1px solid rgba(0,0,0,0.08); background: #e5e7eb; }
  @media (max-width: 768px) { .pk-idx-stats { grid-template-columns: repeat(2, 1fr); } .pk-map { height: 320px; } }
</style>
