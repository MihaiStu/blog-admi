---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout pageBg="bases" title="Base de Datos - Talleres | AdmiLogistic" description="Mapa y listado de talleres especializados en vehículos industriales.">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <div class="db-page">
    <header class="db-header">
      <h1>Talleres</h1>
      <p>Talleres especializados en vehículos industriales. Datos orientativos; para uso integrado en rutas, usa RoadMaster.</p>
    </header>
    <div class="db-map-wrap">
      <div id="map-talleres" class="db-map"></div>
    </div>
    <div class="db-list-wrap">
      <h2>Listado</h2>
      <div id="list-talleres" class="db-list"></div>
    </div>
    <div class="db-cta">
      <a href="/proyectos/roadmaster" class="db-cta-btn">Usar talleres en RoadMaster</a>
    </div>
  </div>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" defer></script>
  <script>
    (function () {
      const mapEl = document.getElementById('map-talleres');
      const listEl = document.getElementById('list-talleres');
      if (!mapEl) return;
      fetch('/data/talleres.json')
        .then(r => r.json())
        .then(data => {
          if (typeof L === 'undefined') return;
          const map = L.map('map-talleres').setView([40.4, -3.7], 6);
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);
          const bounds = [];
          data.forEach(p => {
            const lat = p.coordenadas ? p.coordenadas.lat : p.lat;
            const lng = p.coordenadas ? p.coordenadas.lng : p.lng;
            if (lat == null || lng == null) return;
            bounds.push([lat, lng]);
            const name = p.nombre || '';
            const addr = (p.direccion || '').slice(0, 60);
            L.marker([lat, lng]).addTo(map).bindPopup(`<strong>${escapeHtml(name)}</strong><br>${escapeHtml(addr)}`);
          });
          if (bounds.length) map.fitBounds(bounds, { padding: [30, 30], maxZoom: 10 });
          if (listEl && data.length) {
            listEl.innerHTML = data.slice(0, 30).map(p => {
              const lat = p.coordenadas ? p.coordenadas.lat : p.lat;
              const lng = p.coordenadas ? p.coordenadas.lng : p.lng;
              const addr = p.direccion || (p.provincia ? p.provincia : '');
              const tel = p.telefono ? `<a href="tel:${p.telefono}">${escapeHtml(p.telefono)}</a>` : '';
              return `<div class="db-list-item"><strong>${escapeHtml(p.nombre)}</strong><br><span class="db-list-meta">${escapeHtml(addr)}</span>${tel ? '<br>' + tel : ''}</div>`;
            }).join('');
          }
        })
        .catch(() => { if (listEl) listEl.innerHTML = '<p>No se pudieron cargar los datos.</p>'; });
      function escapeHtml(s) {
        if (!s) return '';
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }
    })();
  </script>
</BaseLayout>

<style>
  .db-page { max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  .db-header { text-align: center; margin-bottom: 1.5rem; }
  .db-header h1 { font-size: clamp(1.75rem, 3vw, 2.25rem); color: #1a1a1a; margin-bottom: 0.5rem; }
  .db-header p { color: #555; font-size: 1rem; line-height: 1.6; }
  .db-map-wrap { margin-bottom: 2rem; border-radius: 16px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.12); border: 1px solid rgba(0,0,0,0.08); }
  .db-map { height: 420px; background: #e5e7eb; }
  .db-list-wrap h2 { font-size: 1.25rem; margin-bottom: 1rem; color: #1a1a1a; }
  .db-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .db-list-item { padding: 1rem; background: rgba(255,255,255,0.9); border-radius: 10px; border-left: 4px solid #0ea5e9; font-size: 0.9375rem; }
  .db-list-item strong { display: block; margin-bottom: 0.25rem; color: #0f172a; }
  .db-list-meta { color: #64748b; }
  .db-list-item a { color: #6366f1; }
  .db-cta { text-align: center; margin-top: 2rem; }
  .db-cta-btn { display: inline-block; padding: 0.75rem 1.75rem; background: #1a1a1a; color: #fff; font-weight: 600; text-decoration: none; border-radius: 10px; transition: background 0.2s; }
  .db-cta-btn:hover { background: #333; }
  @media (max-width: 768px) { .db-map { height: 320px; } .db-list { grid-template-columns: 1fr; } }
</style>
