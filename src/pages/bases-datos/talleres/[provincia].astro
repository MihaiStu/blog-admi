---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import datos from '../../../data/talleres-provincias.json';

export function getStaticPaths() {
  return datos.provincias.map((p) => ({
    params: { provincia: p.slug },
    props: { p },
  }));
}

const { p } = Astro.props;

const urgencias24h = p.items.filter(t => t.urgencias24h);

const title = `Talleres mecánicos para camiones en ${p.provincia} — ${p.numTalleres} talleres | AdmiLogistic`;
const description = `Encuentra ${p.numTalleres} talleres especializados en camiones en ${p.provincia}.${p.numUrgencias24h > 0 ? ` ${p.numUrgencias24h} con servicio de urgencia 24h.` : ''}`;

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Talleres mecánicos para camiones en ${p.provincia}`,
  description,
  numberOfItems: p.numTalleres,
  itemListElement: p.items.slice(0, 10).map((t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: t.nombre,
    description: [t.especialidades?.join(', '), t.urgencias24h ? '24h' : null, t.telefono].filter(Boolean).join(" · "),
  })),
};
---

<BaseLayout pageBg="bases" title={title} description={description}>
  <div class="pk-page">
    <nav class="pk-breadcrumb">
      <a href="/bases-datos/">Bases de datos</a> ·
      <a href="/bases-datos/talleres/">Talleres</a> ·
      <span>{p.provincia}</span>
    </nav>

    <header class="pk-header">
      <h1>Talleres para camiones en {p.provincia}</h1>
      <p class="pk-intro">
        <strong>{p.numTalleres} talleres</strong> especializados en vehículos industriales
        en la provincia de {p.provincia}.
        {p.items.filter(t => t.urgencias24h).length > 0 && ` ${p.items.filter(t => t.urgencias24h).length} con servicio de urgencia 24h.`}
      </p>
    </header>

    <div class="pk-stats">
      <div class="pk-stat">
        <span class="pk-stat-label">Talleres</span>
        <span class="pk-stat-value">{p.numTalleres}</span>
      </div>
      <div class="pk-stat">
        <span class="pk-stat-label">Urgencias 24h</span>
        <span class="pk-stat-value">{p.numUrgencias24h}</span>
      </div>
      <div class="pk-stat">
        <span class="pk-stat-label">Con teléfono</span>
        <span class="pk-stat-value">{p.numConTelefono}</span>
      </div>
      <div class="pk-stat">
        <span class="pk-stat-label">Especialidades</span>
        <span class="pk-stat-value">{p.especialidades.length}</span>
      </div>
    </div>

    <h2>Listado de talleres en {p.provincia}</h2>
    <div class="pk-list">
      {p.items.map((t) => (
        <div class={`pk-item${t.urgencias24h ? ' pk-item--urg' : ''}`}>
          <div class="pk-item-header">
            <strong>{t.nombre}</strong>
            {t.urgencias24h && <span class="pk-item-badge">24h</span>}
          </div>
          <div class="pk-item-meta">
            {t.direccion && <span>{t.direccion}</span>}
            {t.horario && <span>{t.horario}</span>}
            {t.telefono && <a href={`tel:${t.telefono}`} class="pk-tel">{t.telefono}</a>}
            {t.email && <a href={`mailto:${t.email}`}>{t.email}</a>}
          </div>
          {t.especialidades?.length > 0 && (
            <div class="pk-item-servicios">
              {t.especialidades.slice(0, 6).map(s => <span class="pk-tag">{s}</span>)}
              {t.especialidades.length > 6 && <span class="pk-tag pk-tag--more">+{t.especialidades.length - 6}</span>}
            </div>
          )}
        </div>
      ))}
    </div>

    <p class="pk-nota">
      Datos de RoadMaster. Talleres especializados en vehículos industriales y camiones.
    </p>

    <div class="pk-cta">
      <h3>¿Gestionas una flota?</h3>
      <p>Con <strong>RoadMaster</strong> encuentras talleres cercanos en ruta, controlas mantenimientos y planificas paradas.</p>
      <a href="/proyectos/roadmaster/" class="pk-cta-btn">Probar RoadMaster gratis 14 días</a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
</BaseLayout>

<style>
  .pk-page { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
  .pk-breadcrumb { font-size: 0.85rem; color: #cbd5e1; margin-bottom: 1rem; }
  .pk-breadcrumb a { color: #3b82f6; text-decoration: none; }
  .pk-breadcrumb a:hover { text-decoration: underline; }
  .pk-header { margin-bottom: 1.5rem; }
  .pk-header h1 { font-size: clamp(1.6rem, 3vw, 2.25rem); color: #fff; margin-bottom: 0.75rem; text-shadow: 1px 1px 3px rgba(0,0,0,0.4); }
  .pk-intro { color: rgba(255,255,255,0.92); font-size: 1.05rem; line-height: 1.6; max-width: 800px; }
  .pk-intro strong { color: #fff; }

  .pk-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 1.5rem 0; }
  .pk-stat { background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.18); border-radius: 12px; padding: 1rem; text-align: center; }
  .pk-stat-label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: rgba(255,255,255,0.7); margin-bottom: 0.35rem; }
  .pk-stat-value { display: block; font-size: 1.35rem; font-weight: 700; color: #fff; }

  .pk-page h2 { color: #fff; font-size: 1.4rem; margin: 1.5rem 0 1rem; text-shadow: 1px 1px 3px rgba(0,0,0,0.4); }

  .pk-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; }
  .pk-item { background: rgba(15,23,42,0.55); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.15); border-left: 4px solid #3b82f6; border-radius: 12px; padding: 1rem; }
  .pk-item--urg { border-left-color: #ef4444; background: rgba(239,68,68,0.08); }
  .pk-item-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .pk-item-header strong { color: #fff; font-size: 1rem; }
  .pk-item-badge { font-size: 0.65rem; background: #ef4444; color: #fff; padding: 0.15rem 0.5rem; border-radius: 999px; font-weight: 600; flex-shrink: 0; }
  .pk-item-meta { display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.8rem; color: rgba(255,255,255,0.75); margin-bottom: 0.5rem; }
  .pk-item-meta a { color: #60a5fa; text-decoration: none; }
  .pk-item-meta a:hover { text-decoration: underline; }
  .pk-tel { color: #34d399; font-weight: 600; }
  .pk-item-servicios { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .pk-tag { font-size: 0.7rem; background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.85); padding: 0.15rem 0.5rem; border-radius: 999px; }
  .pk-tag--more { background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.55); }

  .pk-nota { font-size: 0.8rem; color: rgba(255,255,255,0.65); margin-top: 1.5rem; line-height: 1.5; }

  .pk-cta { margin-top: 2.5rem; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.18); border-radius: 16px; padding: 1.5rem; text-align: center; }
  .pk-cta h3 { color: #fff; font-size: 1.25rem; margin-bottom: 0.5rem; }
  .pk-cta p { color: rgba(255,255,255,0.9); margin-bottom: 1.1rem; line-height: 1.5; max-width: 560px; margin-left: auto; margin-right: auto; }
  .pk-cta-btn { display: inline-block; padding: 0.8rem 1.9rem; background: #3b82f6; color: #fff; font-weight: 700; text-decoration: none; border-radius: 10px; transition: background 0.2s; }
  .pk-cta-btn:hover { background: #60a5fa; }

  @media (max-width: 640px) {
    .pk-stats { grid-template-columns: repeat(2, 1fr); }
    .pk-list { grid-template-columns: 1fr; }
  }
</style>
