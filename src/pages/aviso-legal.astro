<style>
  .legal-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    color: #1a1a1a;
  }
  .legal-page h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin-bottom: 0.5rem;
    color: #1a1a1a;
  }
  .legal-page .updated {
    font-size: 0.9375rem;
    color: #666;
    margin-bottom: 2rem;
  }
  .legal-page section {
    margin-bottom: 2rem;
  }
  .legal-page h2 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: #0f172a;
  }
  .legal-page p {
    line-height: 1.7;
    margin-bottom: 1rem;
    color: #333;
  }
  .legal-page .contact {
