---
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialLinks } from "../config/social";
import { getCollection } from 'astro:content';

// Obtener los últimos 6 artículos del blog y todos para el buscador
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const ultimosArticulos = sortedPosts.slice(0, 6);
// Datos para búsqueda en cliente (título, descripción, categoría)
const searchIndex = sortedPosts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: (p.data.description || '').slice(0, 200),
  category: p.data.category,
}));
---

<BaseLayout pageBg="home" title="Recursos y Herramientas para Transportistas | AdmiLogistic" description="Centro de recursos profesionales para transportistas y gestores de flotas. Noticias, fiscalidad, tacógrafo, rutas, bases de datos y herramientas de gestión logística.">
  <!-- SCHEMA.ORG JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://admilogistic.es/#organization",
        "name": "AdmiLogistic",
        "url": "https://admilogistic.es",
        "description": "Organización especializada en recursos y herramientas para el transporte profesional y la gestión de flotas",
        "areaServed": {
          "@type": "Place",
          "name": "España"
        },
        "knowsAbout": [
          "Transporte profesional",
          "Gestión de flotas",
          "Logística",
          "Tacógrafo digital",
          "Fiscalidad del transporte"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://admilogistic.es/#website",
        "url": "https://admilogistic.es",
        "name": "AdmiLogistic - Recursos para Transportistas",
        "description": "Centro de recursos profesionales para transportistas y gestores de flotas",
        "publisher": {
          "@id": "https://admilogistic.es/#organization"
        },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://admilogistic.es/buscar?q={search_term_string}"
          },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  })} />
  
  <!-- HERO SECTION -->
  <section class="hero" data-editable="hero">
    <div class="section-inner">
      <div class="hero-content">
      <div class="hero-text">
        <h1>Centro de recursos y herramientas para el transporte profesional</h1>
        <p>Información especializada, bases de datos públicas y herramientas de gestión para transportistas, gestores de flotas y empresas de logística.</p>
        <div class="hero-search" id="hero-search-wrap">
          <input type="search" id="hero-search-input" placeholder="Buscar en el blog..." aria-label="Buscar contenido" autocomplete="off">
          <div class="hero-search-results" id="hero-search-results" role="listbox" aria-hidden="true"></div>
        </div>
        <script define:vars={{ searchIndex: searchIndex }}>
          (function () {
            const input = document.getElementById('hero-search-input');
            const resultsEl = document.getElementById('hero-search-results');
            const wrap = document.getElementById('hero-search-wrap');
            if (!input || !resultsEl || !wrap || !Array.isArray(searchIndex)) return;

            function escapeHtml(s) {
              const div = document.createElement('div');
              div.textContent = s;
              return div.innerHTML;
            }

            function showResults(items) {
              if (!items.length) {
                resultsEl.innerHTML = '<p class="hero-search-empty">No hay resultados para tu búsqueda.</p>';
              } else {
                resultsEl.innerHTML = items.slice(0, 8).map(function (p) {
                  const title = escapeHtml(p.title);
                  const cat = escapeHtml(p.category);
                  return '<a href="/blog/' + escapeHtml(p.id) + '" class="hero-search-item" role="option">' +
                    '<span class="hero-search-item-cat">' + cat + '</span>' +
                    '<span class="hero-search-item-title">' + title + '</span>' +
                    (p.description ? '<span class="hero-search-item-desc">' + escapeHtml(p.description) + '</span>' : '') +
                    '</a>';
                }).join('');
              }
              resultsEl.setAttribute('aria-hidden', 'false');
              resultsEl.classList.add('is-open');
            }

            function hideResults() {
              resultsEl.classList.remove('is-open');
              resultsEl.setAttribute('aria-hidden', 'true');
              resultsEl.innerHTML = '';
            }

            function runSearch() {
              const q = (input.value || '').trim().toLowerCase();
              if (q.length < 2) {
                hideResults();
                return;
              }
              const filtered = searchIndex.filter(function (p) {
                return (p.title && p.title.toLowerCase().indexOf(q) >= 0) ||
                  (p.description && p.description.toLowerCase().indexOf(q) >= 0) ||
                  (p.category && p.category.toLowerCase().indexOf(q) >= 0);
              });
              showResults(filtered);
            }

            input.addEventListener('input', runSearch);
            input.addEventListener('focus', function () { if (input.value.trim().length >= 2) runSearch(); });
            input.addEventListener('keydown', function (e) {
              if (e.key === 'Escape') { hideResults(); input.blur(); }
            });

            document.addEventListener('click', function (e) {
              if (!wrap.contains(e.target)) hideResults();
            });
          })();
        </script>
      </div>
      <div class="hero-image">
        <img src="/images/hero/Portadaok2.webp" alt="Centro de recursos y herramientas para el transporte profesional" class="hero-image-content" loading="eager" />
      </div>
    </div>
    </div>
  </section>

  <!-- LEAD MAGNET BANNER -->
  <section class="lead-magnet-banner">
    <div class="lead-magnet-inner">
      <div class="lead-magnet-content">
        <span class="lead-magnet-badge">GRATIS</span>
        <h2>Kit de Supervivencia del Transportista 2026</h2>
        <p>Descarga gratis: Guía de tiempos de conducción, checklist pre-viaje, plantilla de gastos y calendario fiscal. Todo lo que necesitas en un solo pack.</p>
        <a href="/descargables" class="lead-magnet-cta">Descargar Kit Gratuito</a>
      </div>
      <div class="lead-magnet-visual">
        <div class="kit-preview">
          <div class="kit-item">Guía Tiempos</div>
          <div class="kit-item">Checklist</div>
          <div class="kit-item">Plantilla Gastos</div>
          <div class="kit-item">Calendario Fiscal</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS SECTION -->
  <section class="projects" data-editable="projects">
    <div class="section-inner">
      <h2>Herramientas profesionales para el transporte</h2>
    <p class="section-intro">Ecosistema integrado de plataformas diseñadas para optimizar la gestión de flotas, cumplimiento normativo y operaciones logísticas. Todas las herramientas trabajan de forma coordinada.</p>
    <div class="projects-grid">
      <article class="project-card">
        <div class="project-image">
          <picture>
            <source type="image/webp" srcset="/images/projects/admin-logistic-tools-480.webp 480w, /images/projects/admin-logistic-tools-800.webp 800w, /images/projects/admin-logistic-tools-1200.webp 1200w" sizes="(max-width: 600px) 100vw, 33vw" />
            <img src="/images/projects/admin-logistic-tools-800.webp" srcset="/images/projects/admin-logistic-tools-480.webp 480w, /images/projects/admin-logistic-tools-800.webp 800w, /images/projects/admin-logistic-tools-1200.webp 1200w" sizes="(max-width: 600px) 100vw, 33vw" alt="Admi Logistic Tools" loading="lazy" width="800" />
          </picture>
        </div>
        <h3>Admi Logistic Tools</h3>
        <p>Plataforma completa de administración y gestión logística para empresas de transporte. Parte del ecosistema AdmiLogistic.</p>
        <a href="/proyectos/admin-logistic" class="project-button" aria-label="Ver información de Admi Logistic Tools">Ver Admi Logistic Tools</a>
      </article>

      <article class="project-card">
        <div class="project-image">
          <picture>
            <source type="image/webp" srcset="/images/projects/roadmaster-480.webp 480w, /images/projects/roadmaster-800.webp 800w, /images/projects/roadmaster-1200.webp 1200w" sizes="(max-width: 600px) 100vw, 33vw" />
            <img src="/images/projects/roadmaster-800.webp" srcset="/images/projects/roadmaster-480.webp 480w, /images/projects/roadmaster-800.webp 800w, /images/projects/roadmaster-1200.webp 1200w" sizes="(max-width: 600px) 100vw, 33vw" alt="RoadMaster" loading="lazy" width="800" />
          </picture>
        </div>
        <h3>RoadMaster</h3>
        <p>Solución integral de gestión para empresas de transporte y logística. Integrada con el resto del ecosistema AdmiLogistic.</p>
        <div class="project-card-actions">
          <a href="https://roadmaster.admilogistic.es/register" class="project-button project-button-primary" target="_blank" rel="noopener noreferrer" aria-label="Probar RoadMaster gratis 14 días">Probar gratis 14 días</a>
          <a href="/proyectos/roadmaster" class="project-button project-button-secondary" aria-label="Ver información de RoadMaster">Ver más</a>
        </div>
      </article>

      <article class="project-card">
        <div class="project-image">
          <picture>
            <source type="image/webp" srcset="/images/projects/tacografo-480.webp 480w, /images/projects/tacografo-800.webp 800w, /images/projects/tacografo-1200.webp 1200w" sizes="(max-width: 600px) 100vw, 33vw" />
            <img src="/images/projects/tacografo-800.webp" srcset="/images/projects/tacografo-480.webp 480w, /images/projects/tacografo-800.webp 800w, /images/projects/tacografo-1200.webp 1200w" sizes="(max-width: 600px) 100vw, 33vw" alt="Tacógrafo" loading="lazy" width="800" />
          </picture>
        </div>
        <h3>Tacógrafo</h3>
        <p>Aplicación especializada en la gestión y análisis de datos de tacógrafos digitales. Compatible con RoadMaster y Admi Logistic.</p>
        <a href="/proyectos/tacografo" class="project-button" aria-label="Ver información de la herramienta Tacógrafo">Ver Tacógrafo</a>
      </article>
    </div>
  </section>

  <!-- ÚLTIMOS ARTÍCULOS DEL BLOG -->
  <section class="ultimos-articulos">
    <div class="section-inner">
      <h2>Últimos artículos del blog</h2>
      <p class="section-intro">Guías prácticas, normativa actualizada y consejos para el día a día del transportista profesional.</p>

      {ultimosArticulos.length > 0 ? (
        <div class="articulos-grid-home">
          {ultimosArticulos.map((entry) => (
            <a href={`/blog/${entry.id}`} class="articulo-card-home">
              {entry.data.image && (
                <div class="articulo-image-home">
                  <img src={entry.data.image} alt={entry.data.title} loading="lazy" />
                </div>
              )}
              <div class="articulo-content-home">
                <span class="articulo-categoria">{entry.data.category}</span>
                <h3>{entry.data.title}</h3>
                {entry.data.description && <p>{entry.data.description}</p>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="no-articulos">Próximamente publicaremos artículos.</p>
      )}

      <div class="ver-todos-wrapper">
        <a href="/categorias" class="ver-todos-btn">Ver todas las guías y artículos</a>
      </div>
    </div>
  </section>

  <!-- DATABASES SECTION -->
  <section class="databases" data-editable="databases">
    <div class="section-inner">
      <h2>Bases de datos públicas para transportistas</h2>
      <p class="section-intro">Acceso gratuito a información de talleres, gasolineras, parkings y hoteles adaptados para vehículos industriales.</p>
      <div class="databases-grid">
        <a href="/bases-datos/talleres" class="database-item" aria-label="Ver base de datos de talleres especializados">
          <div class="database-icon">🔧</div>
          <span>Talleres</span>
          <p class="database-desc">Talleres especializados</p>
        </a>
        <a href="/bases-datos/gasolineras" class="database-item" aria-label="Ver base de datos de gasolineras">
          <div class="database-icon">⛽</div>
          <span>Gasolineras</span>
          <p class="database-desc">Estaciones servicio</p>
        </a>
        <a href="/bases-datos/parkings" class="database-item" aria-label="Ver base de datos de áreas de descanso">
          <div class="database-icon">🅿️</div>
          <span>Parkings</span>
          <p class="database-desc">Áreas de descanso</p>
        </a>
        <a href="/bases-datos/hoteles" class="database-item" aria-label="Ver base de datos de alojamiento para transportistas">
          <div class="database-icon">🏨</div>
          <span>Hoteles</span>
          <p class="database-desc">Alojamiento camiones</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --spacing-xs: 0.25rem;
    --spacing-sm: 0.5rem;
    --spacing-md: 1rem;
    --spacing-lg: 1.5rem;
    --spacing-xl: 2rem;
    --spacing-2xl: 3rem;
    --spacing-3xl: 4rem;
    --section-spacing: 6rem;
    --section-padding-y: 64px;
    --radius: 16px;
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.12);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.15);
    --shadow-lg: 0 12px 40px rgba(0, 0, 0, 0.2);
    --text-primary: #1a1a1a;
    --text-secondary: #666;
    --accent-primary: #6366f1;
    --accent-hover: #4f46e5;
    --projects-icon-size: 80px;
    --news-featured-height: 240px;
  }

  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: var(--spacing-sm);
    padding-right: var(--spacing-sm);
    border: none;
    box-shadow: none;
    background: transparent;
  }

  @media (max-width: 768px) {
    .section-inner {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  @media (max-width: 480px) {
    .section-inner {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }

  .hero-content {
    border: none;
    box-shadow: none;
  }

  /* BG AMBIENT TEXT */
  .bg-ambient-text {
    background: transparent;
    color: white;
    padding: 20px 0;
    text-align: center;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    margin-bottom: var(--section-spacing);
    box-shadow: none;
    position: relative;
    z-index: 1;
  }

  /* Sin franjas arriba/abajo del texto ambiente para evitar marcas visibles */
  .bg-ambient-text::before,
  .bg-ambient-text::after {
    display: none;
  }

  .bg-ambient-text p {
    margin: 0;
    padding: 0 var(--spacing-sm);
  }

  .bg-ambient-text a {
    color: white;
    text-decoration: none;
    border-bottom: 2px solid rgba(255, 255, 255, 0.5);
    transition: border-color 0.2s;
    margin-left: var(--spacing-md);
  }

  .bg-ambient-text a:hover {
    border-bottom-color: white;
  }

  /* HERO SECTION */
  .hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    padding: 80px var(--spacing-sm) 96px;
    margin-bottom: var(--section-spacing);
  }

  /* Sin franja inferior en el hero para evitar marcas/bordes visibles */
  .hero::after {
    display: none;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    width: 100%;
  }

  .hero-text h1 {
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }

  .hero-text p {
    font-size: clamp(1.0625rem, 2vw, 1.1875rem);
    color: #ffffff;
    line-height: 1.7;
    margin-bottom: 32px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);
  }

  .hero-search {
    position: relative;
    max-width: 500px;
  }

  .hero-search input {
    width: 100%;
    padding: 16px 24px;
    font-size: 1rem;
    border: 2px solid rgba(255, 255, 255, 0.5);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .hero-search input:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.36), 0 0 0 6px rgba(255, 255, 255, 0.06);
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.95);
  }

  /* Dropdown resultados búsqueda */
  .hero-search-results {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 6px;
    max-height: 380px;
    overflow-y: auto;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(0, 0, 0, 0.08);
    z-index: 100;
  }

  .hero-search-results.is-open {
    display: block;
  }

  .hero-search-empty {
    padding: 1.25rem 1.5rem;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .hero-search-item {
    display: block;
    padding: 0.875rem 1.25rem;
    text-decoration: none;
    color: var(--text-primary);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    transition: background 0.15s ease;
  }

  .hero-search-item:last-child {
    border-bottom: none;
  }

  .hero-search-item:hover {
    background: rgba(99, 102, 241, 0.08);
  }

  .hero-search-item-cat {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--accent-primary);
    margin-bottom: 0.25rem;
  }

  .hero-search-item-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.25rem;
  }

  .hero-search-item-desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.4;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    display: -webkit-box;
  }

  .hero-image {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 100;
    isolation: isolate;
    min-width: 0;
  }

  /* Eliminar cualquier efecto que pueda causar borrosidad */
  .hero-image::before,
  .hero-image::after {
    display: none !important;
    content: none !important;
  }

  .hero-image-content {
    width: 100%;
    max-width: min(var(--hero-image-width, 480px), 100%);
    max-height: min(380px, 55vh);
    height: auto;
    object-fit: contain;
    object-position: center;
    display: block;
    position: relative;
    z-index: 100;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    filter: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    mask: none !important;
    -webkit-mask: none !important;
    clip-path: none !important;
  }

  /* PROJECTS SECTION */
  .projects {
    margin-bottom: var(--section-spacing);
    background: transparent;
    position: relative;
  }

  .projects::after {
    content: '';
    position: absolute;
    bottom: calc(var(--section-spacing) * -0.5);
    left: 0;
    right: 0;
    height: calc(var(--section-spacing) * 0.5);
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.02), transparent);
    pointer-events: none;
  }

  .projects h2 {
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 16px;
    text-align: center;
    letter-spacing: -0.015em;
    line-height: 1.2;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
  }

  .section-intro {
    font-size: 1rem;
    color: #ffffff;
    text-align: center;
    max-width: 700px;
    margin: 0 auto 48px;
    line-height: 1.65;
    text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.8);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch !important;
    justify-items: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .project-card {
    border-radius: var(--radius);
    padding: var(--spacing-md) var(--spacing-lg);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
    display: flex !important;
    flex-direction: column !important;
    background: rgba(255, 255, 255, 0.55) !important;
    backdrop-filter: blur(14px) saturate(1.2) !important;
    -webkit-backdrop-filter: blur(14px) saturate(1.2) !important;
    border: 1px solid rgba(255, 255, 255, 0.35);
    margin: 0 !important;
    height: 100% !important;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .project-image {
    margin: 0 0 var(--spacing-sm) 0;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 60px;
    min-height: 60px;
  }

  .project-image img {
    max-width: 60px;
    max-height: 60px;
    width: 60px;
    height: 60px;
    object-fit: contain;
    margin: 0;
    display: block;
  }

  .project-placeholder {
    width: var(--projects-icon-size);
    height: var(--projects-icon-size);
    border-radius: 12px;
    overflow: hidden;
  }

  .project-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 8px 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .project-card p {
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 var(--spacing-md) 0;
    flex-grow: 1;
    font-size: 0.8125rem;
  }

  .project-button {
    display: inline-block;
    padding: 0.5rem 0.875rem;
    background: var(--accent-primary);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.8125rem;
    transition: all 0.3s ease;
    margin: auto 0 0 0;
  }

  .project-button:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .project-card-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
    flex-wrap: wrap;
  }

  .project-button-primary {
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
  }

  .project-button-primary:hover {
    background: linear-gradient(135deg, #4f46e5, #4338ca) !important;
    box-shadow: 0 6px 18px rgba(99, 102, 241, 0.45) !important;
  }

  .project-button-secondary {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .project-button-secondary:hover {
    background: rgba(255, 255, 255, 0.25) !important;
  }

  /* NEWS SECTION WITH SIDEBAR */
  .news-container {
    max-width: 1200px;
    margin: 0 auto var(--section-spacing);
    padding-top: var(--section-padding-y);
    padding-bottom: var(--section-padding-y);
    padding-left: var(--spacing-sm);
    padding-right: var(--spacing-sm);
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--spacing-xl);
    align-items: start;
    background: transparent;
    position: relative;
  }

  .news-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100vw;
    right: -100vw;
    height: 80px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.015), transparent);
    pointer-events: none;
  }

  .news-container::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: -100vw;
    right: -100vw;
    height: 80px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.015), transparent);
    pointer-events: none;
  }

  .news {
    display: flex;
    flex-direction: column;
  }

  .news h2 {
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 16px;
    text-align: center;
    letter-spacing: -0.015em;
    line-height: 1.2;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
  }

  .news .section-intro {
    margin-bottom: 32px;
  }

  .news-featured {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    margin-bottom: var(--spacing-xl);
    display: grid;
    grid-template-columns: 1fr 1fr;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    background: rgba(255, 255, 255, 0.55) !important;
    backdrop-filter: blur(14px) saturate(1.2) !important;
    -webkit-backdrop-filter: blur(14px) saturate(1.2) !important;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .news-featured:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .news-featured-image {
    height: var(--news-featured-height);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .news-placeholder {
    width: 100%;
    height: 100%;
  }

  .news-featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .news-featured-content {
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .news-featured-content h3 {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .news-featured-content p {
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: var(--spacing-sm);
    font-size: 1rem;
  }

  .news-link {
    color: var(--accent-primary);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .news-link:hover {
    color: var(--accent-hover);
  }

  .news-list {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .news-item {
    border-radius: 12px;
    padding: var(--spacing-sm);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    min-width: 280px;
    display: flex;
    gap: var(--spacing-sm);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    background: rgba(255, 255, 255, 0.55) !important;
    backdrop-filter: blur(14px) saturate(1.2) !important;
    -webkit-backdrop-filter: blur(14px) saturate(1.2) !important;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .news-item:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .news-item-image {
    flex-shrink: 0;
  }

  .news-placeholder-small {
    width: 120px;
    height: 80px;
    border-radius: 8px;
    overflow: hidden;
  }

  .news-item-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .news-item-content h4 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .news-item-content p {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .news-item-link {
    font-size: 0.8125rem;
    color: var(--accent-primary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .news-item-link:hover {
    color: var(--accent-hover);
  }

  /* POPULAR CATEGORIES HORIZONTAL */
  .popular-categories {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-xl);
    position: relative;
  }

  .popular-categories::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(99, 102, 241, 0.2), transparent);
  }

  .popular-categories h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--spacing-lg);
    text-align: center;
    letter-spacing: -0.01em;
  }

  .categories-horizontal {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-md);
  }

  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-xl);
    border-radius: var(--radius);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-primary);
  }

  .category-icon-large {
    font-size: 2.5rem;
    line-height: 1;
  }

  .category-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* SIDEBAR */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .sidebar-card {
    border-radius: var(--radius);
    padding: var(--spacing-xl);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    background: rgba(255, 255, 255, 0.55) !important;
    backdrop-filter: blur(14px) saturate(1.2) !important;
    -webkit-backdrop-filter: blur(14px) saturate(1.2) !important;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .sidebar-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--spacing-md);
    letter-spacing: -0.01em;
  }

  .sidebar-card p {
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: var(--spacing-md);
    font-size: 0.9375rem;
  }

  .sidebar-button {
    display: inline-block;
    width: 100%;
    padding: 0.75rem 1.5rem;
    background: var(--accent-primary);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    text-align: center;
    transition: all 0.3s ease;
  }

  .sidebar-button:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .sidebar-sponsors {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(168, 85, 247, 0.08) 100%);
    border: 2px dashed rgba(99, 102, 241, 0.3) !important;
    text-align: center;
  }

  .sidebar-sponsors h3 {
    color: var(--accent-primary);
    font-size: 1.25rem;
    text-align: center;
  }

  .sidebar-sponsors p {
    text-align: center;
  }

  .sponsors-placeholder {
    margin: var(--spacing-md) 0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: inset 0 2px 8px rgba(99, 102, 241, 0.1);
  }

  .sidebar-follow {
    border-radius: var(--radius);
    padding: var(--spacing-xl);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    background: rgba(255, 255, 255, 0.55) !important;
    backdrop-filter: blur(14px) saturate(1.2) !important;
    -webkit-backdrop-filter: blur(14px) saturate(1.2) !important;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .sidebar-follow h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--spacing-md);
    letter-spacing: -0.01em;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .social-link.linkedin {
    background: linear-gradient(135deg, rgba(10, 102, 194, 0.1), rgba(0, 119, 181, 0.1));
    color: #0a66c2;
  }

  .social-link.linkedin:hover {
    background: linear-gradient(135deg, rgba(10, 102, 194, 0.2), rgba(0, 119, 181, 0.2));
    transform: translateX(4px);
  }

  .social-link.youtube {
    background: linear-gradient(135deg, rgba(255, 0, 0, 0.1), rgba(200, 0, 0, 0.1));
    color: #ff0000;
  }

  .social-link.youtube:hover {
    background: linear-gradient(135deg, rgba(255, 0, 0, 0.2), rgba(200, 0, 0, 0.2));
    transform: translateX(4px);
  }

  .social-link.tiktok {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.1), rgba(254, 44, 85, 0.1));
    color: #000000;
  }

  .social-link.tiktok:hover {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.2), rgba(254, 44, 85, 0.2));
    transform: translateX(4px);
  }

  .social-link.instagram {
    background: linear-gradient(45deg, rgba(255, 48, 107, 0.1), rgba(255, 174, 0, 0.1));
    color: #E1306C;
  }

  .social-link.instagram:hover {
    background: linear-gradient(45deg, rgba(255, 48, 107, 0.2), rgba(255, 174, 0, 0.2));
    transform: translateX(4px);
  }

  .social-link.facebook {
    background: linear-gradient(135deg, rgba(24, 119, 242, 0.1), rgba(0, 82, 204, 0.1));
    color: #1877f2;
  }

  .social-link.facebook:hover {
    background: linear-gradient(135deg, rgba(24, 119, 242, 0.2), rgba(0, 82, 204, 0.2));
    transform: translateX(4px);
  }

  .social-link.twitter {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.1), rgba(50, 50, 50, 0.1));
    color: #000000;
  }

  .social-link.twitter:hover {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.2), rgba(50, 50, 50, 0.2));
    transform: translateX(4px);
  }

  .icon-social {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .sidebar-categories {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .category-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    background: rgba(99, 102, 241, 0.1);
    color: var(--text-primary);
    font-weight: 500;
    font-size: 0.9375rem;
    transition: all 0.2s;
  }

  .category-link:hover {
    background: rgba(99, 102, 241, 0.2);
    transform: translateX(4px);
  }

  .category-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  /* VIDEOS SECTION */
  .videos {
    max-width: 1200px;
    margin: 0 auto var(--section-spacing);
    padding-top: var(--section-padding-y);
    padding-bottom: var(--section-padding-y);
    padding-left: var(--spacing-sm);
    padding-right: var(--spacing-sm);
    background: transparent;
    position: relative;
  }

  .videos::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.02), transparent);
    pointer-events: none;
  }

  .videos h2 {
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 16px;
    text-align: center;
    letter-spacing: -0.015em;
    line-height: 1.2;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
  }

  .videos .section-intro {
    margin-bottom: 32px;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    justify-items: stretch;
  }

  .video-card {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    background: rgba(255, 255, 255, 0.55) !important;
    backdrop-filter: blur(14px) saturate(1.2) !important;
    -webkit-backdrop-filter: blur(14px) saturate(1.2) !important;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
  }

  .video-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .video-thumbnail {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .video-placeholder {
    width: 100%;
    height: 100%;
  }

  .video-card h4 {
    padding: var(--spacing-md) var(--spacing-md) 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
    letter-spacing: -0.005em;
    flex: 1 0 auto;
    margin: 0;
  }

  .video-link {
    display: block;
    padding: 0 var(--spacing-md) var(--spacing-md);
    font-size: 0.8125rem;
    color: var(--accent-primary);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
    margin: 0;
  }

  .video-link:hover {
    color: var(--accent-hover);
  }

  /* DATABASES SECTION */
  .databases {
    max-width: 1200px;
    margin: 0 auto 0;
    padding-top: var(--section-padding-y);
    padding-bottom: var(--section-padding-y);
    padding-left: var(--spacing-sm);
    padding-right: var(--spacing-sm);
    background: transparent;
    position: relative;
  }

  .databases::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.02), transparent);
    pointer-events: none;
  }

  .databases h2 {
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 16px;
    text-align: center;
    letter-spacing: -0.015em;
    line-height: 1.2;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
  }

  .databases .section-intro {
    margin-bottom: 32px;
  }

  .databases-grid {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 1.5rem !important;
    align-items: stretch !important;
    justify-items: stretch !important;
  }

  .database-item {
    border-radius: var(--radius);
    padding: var(--spacing-lg);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    text-decoration: none;
    color: var(--text-primary);
    display: flex !important;
    flex-direction: column !important;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
    background: rgba(255, 255, 255, 0.55) !important;
    backdrop-filter: blur(14px) saturate(1.2) !important;
    -webkit-backdrop-filter: blur(14px) saturate(1.2) !important;
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    min-height: 160px !important;
    height: 100% !important;
    margin: 0 !important;
  }

  .database-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .database-icon {
    font-size: 2.25rem;
    line-height: 1;
    margin: 0;
  }

  .database-item span {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
    margin: 0;
  }

  .database-item .database-desc {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .news-container {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }

    .sidebar {
      order: -1;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .sidebar-card,
    .sidebar-follow {
      flex: 1 1 calc(50% - var(--spacing-sm));
      min-width: 280px;
    }

    .social-links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--spacing-xs);
    }

    .social-link {
      flex: 1 1 auto;
      justify-content: center;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }

    .social-link span {
      display: none;
    }

    .icon-social {
      width: 24px;
      height: 24px;
    }
  }

  @media (max-width: 1024px) {
    .hero-content {
      gap: 48px;
    }
    
    .news-container {
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: 80px var(--spacing-sm) 64px;
      margin-bottom: 64px;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-image {
      order: -1;
    }

    .hero-text h1 {
      margin-bottom: 20px;
    }

    .hero-text p {
      margin-bottom: 24px;
    }

    .projects,
    .news-container,
    .videos,
    .databases {
      margin-bottom: 64px;
    }

    .projects h2,
    .news h2,
    .videos h2,
    .databases h2 {
      margin-bottom: 24px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
      max-width: 400px;
      margin: 0 auto;
    }

    .videos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-md);
    }

    .categories-horizontal {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-sm);
    }

    .category-card {
      padding: var(--spacing-md);
    }

    .category-icon-large {
      font-size: 2rem;
    }

    .category-name {
      font-size: 0.875rem;
    }

    .news-featured {
      grid-template-columns: 1fr;
      margin-bottom: var(--spacing-lg);
    }

    .news-featured-image {
      height: 180px;
    }

    .news-featured-content {
      padding: var(--spacing-lg);
    }

    .news-featured-content h3 {
      font-size: 1.125rem;
    }

    .databases-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: var(--spacing-sm) !important;
    }

    .database-item {
      min-height: 120px !important;
      padding: var(--spacing-md) !important;
    }

    .database-icon {
      font-size: 1.75rem;
    }

    .database-item span {
      font-size: 0.875rem;
    }

    .project-card,
    .sidebar-card,
    .sidebar-follow {
      padding: var(--spacing-lg);
    }

    /* Sidebar en móvil */
    .sidebar {
      flex-direction: column;
    }

    .sidebar-card,
    .sidebar-follow {
      flex: 1 1 100%;
      min-width: 100%;
    }

    .sidebar-sponsors {
      padding: var(--spacing-lg);
    }

    .sponsors-placeholder {
      display: none;
    }

    .sidebar-sponsors h3 {
      font-size: 1rem;
    }

    .sidebar-sponsors p {
      font-size: 0.875rem;
      margin-bottom: var(--spacing-sm);
    }

    .social-links {
      display: grid;
