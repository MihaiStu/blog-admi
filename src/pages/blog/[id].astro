---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSense from "../../components/AdSense.astro";
import { getCollection, getEntry, render } from "astro:content";

// Slots de AdSense: crea bloques en el panel de Google AdSense y pon aquí los IDs (números).
// Opcional: define PUBLIC_ADSENSE_SLOT_ARTICLE_TOP y PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM en .env
const adSlotTop = import.meta.env.PUBLIC_ADSENSE_SLOT_ARTICLE_TOP || "";
const adSlotBottom = import.meta.env.PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM || "";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const categoryLabel: Record<string, string> = {
  operaciones: "Operaciones",
  cumplimiento: "Cumplimiento",
  fiscalidad: "Fiscalidad",
  vehiculos: "Vehículos",
  "tarjetas-gasoil": "Tarjetas de Gasoil",
  actualidad: "Actualidad",
};
---

<BaseLayout
  pageBg="categorias"
  title={`${post.data.title} | Blog AdmiLogistic`}
  description={typeof post.data.description === 'string' ? (post.data.description.slice(0, 155).replace(/\s+\S*$/, '') || post.data.title.slice(0, 155)) : (post.data.title || '').slice(0, 155).replace(/\s+\S*$/, '')}
  image={post.data.image}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description ?? post.data.title,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": post.data.pubDate.toISOString(),
    "image": post.data.image ? `https://www.admilogistic.es${post.data.image}` : "https://www.admilogistic.es/images/hero/Portadaok2.png",
    "author": { "@type": "Organization", "name": "AdmiLogistic", "url": "https://www.admilogistic.es" },
    "publisher": {
      "@type": "Organization",
      "name": "AdmiLogistic",
      "url": "https://www.admilogistic.es",
      "logo": { "@type": "ImageObject", "url": "https://www.admilogistic.es/favicon.svg" }
    },
    "mainEntityOfPage": { "@type": "WebPage", "@id": `https://www.admilogistic.es/blog/${post.id}` },
    "inLanguage": "es-ES"
  })} />
  <article class="article-page">
    {post.data.image && (
      <figure class:list={["article-image", post.id === "2026-02-06-lona-frigo-contenedor-verdad-autoescuela" && "article-image--contain", post.id === "2026-03-10-informe-tecnico-mercado-transporte-2026" && "article-image--same-size-contain"]}>
        <img src={encodeURI(post.data.image.startsWith("/") ? post.data.image : `/${post.data.image}`)} alt={post.data.title} loading="eager" />
      </figure>
    )}
    <header class="article-header">
      <a href={`/categorias/${post.data.category === "tarjetas-gasoil" ? "tarjetas-gasoil" : post.data.category}`} class="article-category">
        {categoryLabel[post.data.category] ?? post.data.category}
      </a>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" })}
      </time>
    </header>

    {adSlotTop && <AdSense adSlot={adSlotTop} className="article-ad-top" />}

    <div class="article-layout">
      <!-- TOC Sidebar -->
      {headings && headings.length > 0 && (
        <aside class="toc-sidebar">
          <div class="toc-container">
            <h4 class="toc-title">En este artículo</h4>
            <nav class="toc-nav">
              <ul class="toc-list">
                {headings.filter(h => h.depth <= 3).map(heading => (
                  <li class={`toc-item toc-h${heading.depth}`}>
                    <a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </aside>
      )}

      <!-- Article Content -->
      <div class="article-body">
        <Content />
      </div>
    </div>

    {adSlotBottom && <AdSense adSlot={adSlotBottom} className="article-ad-bottom" />}

    <!-- CTA Final -->
    <div class="article-cta">
      <div class="cta-content">
        <h3>Descarga gratis el Kit del Transportista 2026</h3>
        <p>Guía de tiempos, checklist pre-viaje, plantilla de gastos y calendario fiscal.</p>
        <a href="/descargables" class="cta-button">Descargar Kit Gratuito</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
  }

  /* Mismo tamaño para todas las imágenes destacadas (informe rentabilidad, base logística, etc.) */
  .article-image {
    margin: 0 auto 2rem;
    width: 100%;
    max-width: 900px;
    height: 500px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
    background: #1e293b;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  /* Imagen comparativa: mostrar completa para que se lea el texto (sin recortar) */
  .article-image--contain {
    background: #1e293b;
  }

  .article-image--contain img {
    object-fit: contain;
    max-height: 580px;
  }

  /* Misma caja que el resto (500px) pero imagen completa sin recortar */
  .article-image--same-size-contain img {
    object-fit: contain;
    max-height: 500px;
  }

  /* Slide / banner: mostrar imagen completa, sin recortar ni forzar proporción */
  .article-image--slide {
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    background: #1a1a2e;
  }

  .article-image--slide img {
    object-fit: contain;
    width: 100%;
    height: auto;
    max-height: none;
    display: block;
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .article-category {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #6366f1;
    text-decoration: none;
    margin-bottom: 0.75rem;
    background: rgba(99, 102, 241, 0.15);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
  }

  .article-category:hover {
    background: rgba(99, 102, 241, 0.25);
  }

  .article-header h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem 0;
    color: #1a1a1a;
    line-height: 1.2;
  }

  .article-header time {
    font-size: 0.9375rem;
    color: #666;
  }

  .article-body {
    padding: 2.5rem;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(12px);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    line-height: 1.8;
    color: #1a1a1a;
    font-size: 1.0625rem;
  }

  .article-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    color: #0f172a;
    border-bottom: 2px solid rgba(99, 102, 241, 0.3);
    padding-bottom: 0.5rem;
  }

  .article-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    color: #1e293b;
  }

  .article-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.75rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body :global(strong) {
    color: #0f172a;
  }

  .article-body :global(a) {
    color: #ff6b35;
    font-weight: 600;
    text-decoration-color: rgba(255, 107, 53, 0.35);
    text-underline-offset: 3px;
  }

  .article-body :global(a:hover) {
    color: #ea580c;
    text-decoration: underline;
    text-decoration-color: #ea580c;
  }

  .article-body :global(img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 2rem 0;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
  }

  .article-body :global(hr) {
    border: none;
    border-top: 2px solid rgba(99, 102, 241, 0.2);
    margin: 2.5rem 0;
  }

  /* Tablas responsive */
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    text-align: left;
    white-space: nowrap;
  }

  .article-body :global(th) {
    background: rgba(99, 102, 241, 0.1);
    font-weight: 600;
    color: #0f172a;
  }

  .article-body :global(tr:nth-child(even)) {
    background: rgba(0, 0, 0, 0.02);
  }

  /* Blockquotes */
  .article-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    background: rgba(99, 102, 241, 0.08);
    border-left: 4px solid #6366f1;
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: #334155;
  }

  .article-body :global(blockquote p) {
    margin: 0;
  }

  /* Videos/iframes */
  .article-body :global(.video-container) {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    margin: 2rem 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .article-body :global(.video-container iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .article-body :global(iframe) {
    max-width: 100%;
    border-radius: 12px;
  }

  /* ============================================
     COMPARATIVA: Fichas plataforma (fondo oscuro)
     ============================================ */
  .article-body :global(.comparativa-intro) {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #1e293b;
    margin-bottom: 2rem;
  }

  .article-body :global(.fichas-plataforma) {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .article-body :global(.ficha-plataforma) {
    background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
    color: #f1f5f9;
    border-radius: 16px;
    padding: 1.5rem 1.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .article-body :global(.ficha-plataforma h3) {
    margin: 0 0 1rem 0;
    font-size: 1.25rem;
    color: #fff;
    border-bottom: none;
    padding-bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .article-body :global(.ficha-plataforma .ficha-uso) {
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 1rem;
  }

  .article-body :global(.ficha-plataforma .ficha-uso strong) {
    color: #cbd5e1;
  }

  .article-body :global(.ficha-pro) {
    background: rgba(34, 197, 94, 0.2);
    border-left: 4px solid #22c55e;
    color: #dcfce7;
    padding: 0.75rem 1rem;
    border-radius: 0 8px 8px 0;
    margin: 0.75rem 0;
    font-size: 0.9375rem;
  }

  .article-body :global(.ficha-pro strong) {
    color: #86efac;
  }

  .article-body :global(.ficha-contra) {
    background: rgba(239, 68, 68, 0.2);
    border-left: 4px solid #ef4444;
    color: #fecaca;
    padding: 0.75rem 1rem;
    border-radius: 0 8px 8px 0;
    margin: 0.75rem 0;
    font-size: 0.9375rem;
  }

  .article-body :global(.ficha-contra strong) {
    color: #fca5a5;
  }

  .article-body :global(.ficha-dato) {
    background: rgba(251, 191, 36, 0.15);
    border-left: 4px solid #eab308;
    color: #fef9c3;
    padding: 0.75rem 1rem;
    border-radius: 0 8px 8px 0;
    margin: 0.75rem 0 0 0;
    font-size: 0.9rem;
  }

  .article-body :global(.ficha-dato strong) {
    color: #fde047;
  }

  /* Tabla comparativa AdmiLogistic (oscura) */
  .article-body :global(.tabla-comparativa-admilogistic) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    font-size: 0.9375rem;
  }

  .article-body :global(.tabla-comparativa-admilogistic thead) {
    background: #0f172a;
    color: #fff;
  }

  .article-body :global(.tabla-comparativa-admilogistic th) {
    padding: 1rem 1.25rem;
    text-align: left;
    font-weight: 700;
    border: none;
  }

  .article-body :global(.tabla-comparativa-admilogistic td) {
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: #1e293b;
    color: #e2e8f0;
  }

  .article-body :global(.tabla-comparativa-admilogistic tbody tr:last-child td) {
    border-bottom: none;
  }

  .article-body :global(.tabla-comparativa-admilogistic tbody tr:nth-child(even) td) {
    background: #334155;
  }

  .article-body :global(.conclusion-directa) {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(139, 92, 246, 0.1) 100%);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
    margin: 2rem 0;
  }

  .article-body :global(.conclusion-directa h3) {
    margin: 0 0 0.75rem 0;
    font-size: 1.2rem;
    color: #4338ca;
  }

  .article-body :global(.conclusion-directa p) {
    margin: 0;
    color: #374151;
    line-height: 1.7;
  }

  .article-body :global(.cta-kit-banner) {
    background: linear-gradient(145deg, #0f172a 0%, #1e293b 100%);
    color: #fff;
    border-radius: 16px;
    padding: 2rem;
    text-align: center;
    margin: 2.5rem 0 0 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .article-body :global(.cta-kit-banner h3) {
    margin: 0 0 0.5rem 0;
    font-size: 1.35rem;
    color: #fff;
  }

  .article-body :global(.cta-kit-banner p) {
    margin: 0 0 1.25rem 0;
    color: #cbd5e1;
    font-size: 1rem;
  }

  .article-body :global(.cta-kit-banner .cta-kit-btn) {
    display: inline-block;
    background: #22c55e;
    color: #0f172a;
    font-weight: 700;
    padding: 0.875rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .article-body :global(.cta-kit-banner .cta-kit-btn:hover) {
    background: #16a34a;
    transform: translateY(-1px);
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .article-page {
      max-width: 100%;
      padding: 1.5rem 1.5rem 3rem;
    }

    .article-body {
      padding: 2rem;
    }
  }

  /* Móvil */
  @media (max-width: 768px) {
    .article-page {
      padding: 1rem 1rem 3rem;
    }

    .article-header {
      padding: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .article-header h1 {
      font-size: 1.5rem;
    }

    .article-body {
      padding: 1.25rem;
      font-size: 1rem;
      line-height: 1.7;
    }

    .article-body :global(h2) {
      font-size: 1.25rem;
      margin-top: 2rem;
    }

    .article-body :global(h3) {
      font-size: 1.1rem;
    }

    .article-body :global(img) {
      margin: 1.5rem 0;
      border-radius: 8px;
    }

    .article-image {
      border-radius: 12px;
      margin-bottom: 1.5rem;
    }

    .article-image img {
      max-height: 250px;
    }

    .article-image--contain img {
      max-height: 340px;
    }

    .article-body :global(table) {
      font-size: 0.875rem;
    }

    .article-body :global(th),
    .article-body :global(td) {
      padding: 0.5rem 0.75rem;
    }

    .article-body :global(blockquote) {
      padding: 0.875rem 1rem;
      margin: 1.25rem 0;
    }

    .article-body :global(.tabla-comparativa-admilogistic) {
      font-size: 0.8125rem;
      display: block;
      overflow-x: auto;
    }

    .article-body :global(.tabla-comparativa-admilogistic th),
    .article-body :global(.tabla-comparativa-admilogistic td) {
      padding: 0.65rem 0.75rem;
    }

    .article-body :global(.cta-kit-banner) {
      padding: 1.5rem;
    }

    .article-body :global(.cta-kit-banner h3) {
      font-size: 1.15rem;
    }
  }

  /* Móvil pequeño */
  @media (max-width: 480px) {
    .article-page {
      padding: 0.75rem 0.75rem 2rem;
    }

    .article-header,
    .article-body {
      padding: 1rem;
      border-radius: 8px;
    }

    .article-header h1 {
      font-size: 1.35rem;
    }

    .article-category {
      font-size: 0.8rem;
      padding: 0.25rem 0.5rem;
    }

    .article-body {
      font-size: 0.9375rem;
    }

    .article-body :global(ul),
    .article-body :global(ol) {
      padding-left: 1.25rem;
    }

    .article-image img {
      max-height: 200px;
    }

    .article-image--contain img {
      max-height: 280px;
    }

    .article-body :global(table) {
      font-size: 0.8125rem;
    }

    .article-body :global(th),
    .article-body :global(td) {
      padding: 0.4rem 0.5rem;
    }

    .article-body :global(blockquote) {
      padding: 0.75rem;
      font-size: 0.9rem;
    }
  }

  /* ============================================
     ARTICLE LAYOUT WITH TOC SIDEBAR
     ============================================ */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 2rem;
    align-items: start;
  }

  /* TOC Sidebar */
  .toc-sidebar {
    order: 2;
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }

  .toc-container {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(12px);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 1.25rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .toc-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 1rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid rgba(99, 102, 241, 0.2);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .toc-nav {
    font-size: 0.875rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    margin-bottom: 0.5rem;
  }

  .toc-item.toc-h3 {
    padding-left: 1rem;
  }

  .toc-link {
    color: #4b5563;
    text-decoration: none;
    display: block;
    padding: 0.375rem 0.5rem;
    border-radius: 6px;
    line-height: 1.4;
    transition: all 0.2s ease;
  }

  .toc-link:hover {
    color: #6366f1;
    background: rgba(99, 102, 241, 0.1);
  }

  .toc-h3 .toc-link {
    font-size: 0.8125rem;
    color: #6b7280;
  }

  /* Article body in grid */
  .article-layout .article-body {
    order: 1;
  }

  /* ============================================
     CALLOUT BOXES / CAJAS DESTACADAS
     ============================================ */

  /* Info box - azul */
  .article-body :global(.info-box),
  .article-body :global(.callout-info) {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(99, 102, 241, 0.1) 100%);
    border-left: 4px solid #3b82f6;
    border-radius: 0 12px 12px 0;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }

  .article-body :global(.info-box)::before,
  .article-body :global(.callout-info)::before {
    content: "ℹ️ Información";
    display: block;
    font-weight: 700;
    color: #1d4ed8;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }

  /* Warning box - amarillo */
  .article-body :global(.warning-box),
  .article-body :global(.callout-warning) {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.15) 0%, rgba(245, 158, 11, 0.1) 100%);
    border-left: 4px solid #f59e0b;
    border-radius: 0 12px 12px 0;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }

  .article-body :global(.warning-box)::before,
  .article-body :global(.callout-warning)::before {
    content: "⚠️ Atención";
    display: block;
    font-weight: 700;
    color: #b45309;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }

  /* Tip box - verde */
  .article-body :global(.tip-box),
  .article-body :global(.callout-tip) {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.1) 0%, rgba(16, 185, 129, 0.1) 100%);
