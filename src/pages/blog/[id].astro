---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSense from "../../components/AdSense.astro";
import { getCollection, getEntry, render } from "astro:content";

// Slots de AdSense: crea bloques en el panel de Google AdSense y pon aquí los IDs (números).
// Opcional: define PUBLIC_ADSENSE_SLOT_ARTICLE_TOP y PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM en .env
const adSlotTop = import.meta.env.PUBLIC_ADSENSE_SLOT_ARTICLE_TOP || "";
const adSlotBottom = import.meta.env.PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM || "";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const categoryLabel: Record<string, string> = {
  operaciones: "Operaciones",
  cumplimiento: "Cumplimiento",
  fiscalidad: "Fiscalidad",
  vehiculos: "Vehículos",
  "tarjetas-gasoil": "Tarjetas de Gasoil",
  actualidad: "Actualidad",
};
---

<BaseLayout
  pageBg="categorias"
  title={`${post.data.title} | Blog AdmiLogistic`}
  description={post.data.description ?? post.data.title}
>
  <article class="article-page">
    {post.data.image && (
      <figure class="article-image">
        <img src={post.data.image.startsWith("/") ? post.data.image : `/${post.data.image}`} alt={post.data.title} loading="eager" />
      </figure>
    )}
    <header class="article-header">
      <a href={`/categorias/${post.data.category === "tarjetas-gasoil" ? "tarjetas-gasoil" : post.data.category}`} class="article-category">
        {categoryLabel[post.data.category] ?? post.data.category}
      </a>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" })}
      </time>
    </header>

    {adSlotTop && <AdSense adSlot={adSlotTop} className="article-ad-top" />}

    <div class="article-body">
      <Content />
    </div>

    {adSlotBottom && <AdSense adSlot={adSlotBottom} className="article-ad-bottom" />}
  </article>
</BaseLayout>

<style>
  .article-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
  }

  .article-image {
    margin: 0 0 2rem 0;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  .article-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 500px;
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(12px);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .article-category {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #6366f1;
    text-decoration: none;
    margin-bottom: 0.75rem;
    background: rgba(99, 102, 241, 0.15);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
  }

  .article-category:hover {
    background: rgba(99, 102, 241, 0.25);
  }

  .article-header h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin: 0 0 0.75rem 0;
    color: #1a1a1a;
    line-height: 1.2;
  }

  .article-header time {
    font-size: 0.9375rem;
    color: #666;
  }

  .article-body {
    padding: 2.5rem;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(12px);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    line-height: 1.8;
    color: #1a1a1a;
    font-size: 1.0625rem;
  }

  .article-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    color: #0f172a;
    border-bottom: 2px solid rgba(99, 102, 241, 0.3);
    padding-bottom: 0.5rem;
  }

  .article-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    color: #1e293b;
  }

  .article-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.75rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body :global(strong) {
    color: #0f172a;
  }

  .article-body :global(a) {
    color: #6366f1;
    font-weight: 500;
  }

  .article-body :global(a:hover) {
    text-decoration: underline;
  }

  .article-body :global(img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 2rem 0;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
  }

  .article-body :global(hr) {
    border: none;
    border-top: 2px solid rgba(99, 102, 241, 0.2);
    margin: 2.5rem 0;
  }

  /* Tablas responsive */
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .article-body :global(th),
  .article-body :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    text-align: left;
    white-space: nowrap;
  }

  .article-body :global(th) {
    background: rgba(99, 102, 241, 0.1);
    font-weight: 600;
    color: #0f172a;
  }

  .article-body :global(tr:nth-child(even)) {
    background: rgba(0, 0, 0, 0.02);
  }

  /* Blockquotes */
  .article-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    background: rgba(99, 102, 241, 0.08);
    border-left: 4px solid #6366f1;
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: #334155;
  }

  .article-body :global(blockquote p) {
    margin: 0;
  }

  /* Videos/iframes */
  .article-body :global(.video-container) {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    margin: 2rem 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .article-body :global(.video-container iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .article-body :global(iframe) {
    max-width: 100%;
    border-radius: 12px;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .article-page {
      max-width: 100%;
      padding: 1.5rem 1.5rem 3rem;
    }

    .article-body {
      padding: 2rem;
    }
  }

  /* Móvil */
  @media (max-width: 768px) {
    .article-page {
      padding: 1rem 1rem 3rem;
    }

    .article-header {
      padding: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .article-header h1 {
      font-size: 1.5rem;
    }

    .article-body {
      padding: 1.25rem;
      font-size: 1rem;
      line-height: 1.7;
    }

    .article-body :global(h2) {
      font-size: 1.25rem;
      margin-top: 2rem;
    }

    .article-body :global(h3) {
      font-size: 1.1rem;
    }

    .article-body :global(img) {
      margin: 1.5rem 0;
      border-radius: 8px;
    }

    .article-image {
      border-radius: 12px;
      margin-bottom: 1.5rem;
    }

    .article-image img {
      max-height: 250px;
    }

    .article-body :global(table) {
      font-size: 0.875rem;
    }

    .article-body :global(th),
    .article-body :global(td) {
      padding: 0.5rem 0.75rem;
    }

    .article-body :global(blockquote) {
      padding: 0.875rem 1rem;
      margin: 1.25rem 0;
    }
  }

  /* Móvil pequeño */
  @media (max-width: 480px) {
    .article-page {
      padding: 0.75rem 0.75rem 2rem;
    }

    .article-header,
    .article-body {
      padding: 1rem;
      border-radius: 8px;
    }

    .article-header h1 {
      font-size: 1.35rem;
    }

    .article-category {
      font-size: 0.8rem;
      padding: 0.25rem 0.5rem;
    }

    .article-body {
      font-size: 0.9375rem;
    }

    .article-body :global(ul),
    .article-body :global(ol) {
      padding-left: 1.25rem;
    }

    .article-image img {
      max-height: 200px;
    }

    .article-body :global(table) {
      font-size: 0.8125rem;
    }

    .article-body :global(th),
    .article-body :global(td) {
      padding: 0.4rem 0.5rem;
    }

    .article-body :global(blockquote) {
      padding: 0.75rem;
      font-size: 0.9rem;
    }
  }
</style>
