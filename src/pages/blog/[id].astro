---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdSense from "../../components/AdSense.astro";
import { getCollection, getEntry, render } from "astro:content";

// Slots de AdSense: crea bloques en el panel de Google AdSense y pon aquí los IDs (números).
// Opcional: define PUBLIC_ADSENSE_SLOT_ARTICLE_TOP y PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM en .env
const adSlotTop = import.meta.env.PUBLIC_ADSENSE_SLOT_ARTICLE_TOP || "";
const adSlotBottom = import.meta.env.PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM || "";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const postDate = post.data.pubDate ?? post.data.date ?? new Date();

// Artículos relacionados: misma categoría, excluir el actual, máx 4
const allPosts = await getCollection("blog");
const related = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0))
  .slice(0, 4);
const categoryLabel: Record<string, string> = {
  operaciones: "Operaciones",
  cumplimiento: "Cumplimiento",
  fiscalidad: "Fiscalidad",
  vehiculos: "Vehículos",
  "tarjetas-gasoil": "Tarjetas de Gasoil",
  actualidad: "Actualidad",
};
---

<BaseLayout
  pageBg="categorias"
  title={`${post.data.title} | AdmiLogistic`}
  description={typeof post.data.description === 'string' ? (post.data.description.slice(0, 155).replace(/\s+\S*$/, '') || post.data.title.slice(0, 155)) : (post.data.title || '').slice(0, 155).replace(/\s+\S*$/, '')}
  image={post.data.image}
  ogType="article"
>
  <meta property="article:published_time" content={postDate.toISOString()} slot="head" />
  <meta property="article:section" content={post.data.category ?? "blog"} slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description ?? post.data.title,
    "datePublished": postDate.toISOString(),
    "dateModified": (post.data.lastUpdated ?? post.data.pubDate ?? post.data.date ?? new Date()).toISOString(),
    "image": {
      "@type": "ImageObject",
      "url": post.data.image ? `https://admilogistic.es${post.data.image}` : "https://admilogistic.es/images/hero/Portadaok2.webp",
      "width": 1200,
      "height": 630
    },
    "author": {
      "@type": "Person",
      "name": "Equipo AdmiLogistic",
      "url": "https://admilogistic.es/sobre-nosotros"
    },
    "publisher": {
      "@type": "Organization",
      "name": "AdmiLogistic",
      "url": "https://admilogistic.es",
      "logo": { "@type": "ImageObject", "url": "https://admilogistic.es/favicon.svg" }
    },
    "mainEntityOfPage": { "@type": "WebPage", "@id": `https://admilogistic.es/blog/${post.id}/` },
    "inLanguage": "es-ES"
  })} />
  {post.id === "2026-02-07-autonomo-o-sociedad-rentabilidad-ruta" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Es mejor ser autónomo o crear una sociedad para el transporte?",
          "acceptedAnswer": { "@type": "Answer", "text": "Depende del volumen de facturación y la situación personal. Como autónomo pagas IRPF sobre el beneficio (puede llegar al 47%) y cuota fija a la Seguridad Social. Con una SL tributas al 25% de IS y puedes optimizar el salario del socio. En general, a partir de 40.000–50.000€ de beneficio neto anual suele compensar la SL, pero hay que analizar cada caso con un asesor fiscal." }},
        { "@type": "Question", "name": "¿Cuándo compensa crear una SL siendo transportista?",
          "acceptedAnswer": { "@type": "Answer", "text": "Crear una SL compensa cuando el beneficio neto supera los 40.000–50.000€ anuales, cuando se quiere limitar la responsabilidad personal ante deudas, cuando se van a incorporar socios o se quiere transmitir la empresa. También si se prevé reinvertir beneficios en la empresa, ya que el IS al 25% es más ventajoso que el IRPF en tramos altos." }},
        { "@type": "Question", "name": "¿Qué impuestos paga un autónomo transportista en España?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un autónomo transportista paga: IRPF sobre el rendimiento neto de la actividad (estimación directa o módulos), IVA trimestral (21% en servicios de transporte, con las deducciones aplicables), cuota de autónomos a la Seguridad Social (sistema de cotización por ingresos reales desde 2023) y retenciones del 15% en facturas a empresas si supera el umbral." }}
      ]
    })} />
  )}
  {post.id === "2026-02-06-lona-frigo-contenedor-verdad-autoescuela" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Qué diferencia hay entre una lona (tauliner) y un frigorífico en el transporte?",
          "acceptedAnswer": { "@type": "Answer", "text": "La lona o tauliner es un semirremolque de carga general con lonas laterales corredizas, ideal para palets y mercancía seca. El frigorífico es un semirremolque con caja cerrada y sistema de temperatura controlada (entre -25°C y +25°C), obligatorio para alimentación perecedera, medicamentos o flores. Tienen normativas de carga, documentación y mantenimiento completamente distintas." }},
        { "@type": "Question", "name": "¿Qué documentación necesita un conductor para transportar en contenedor?",
          "acceptedAnswer": { "@type": "Answer", "text": "Para transportar en contenedor se necesita: CMR o carta de porte, booking de la naviera, packing list de la carga, certificado de estiba del contenedor (VGM en tráfico marítimo), y en algunos casos, declaración de mercancías peligrosas si aplica el ADR. El conductor debe verificar que los twist-locks estén bloqueados antes de salir de la terminal." }},
        { "@type": "Question", "name": "¿Qué es un remolque de piso móvil y para qué se usa?",
          "acceptedAnswer": { "@type": "Answer", "text": "El remolque de piso móvil (walking floor) tiene el suelo formado por listones que se desplazan hidráulicamente hacia atrás, expulsando la carga sin necesidad de volcar ni usar carretilla. Se usa para residuos, biomasa, madera, chatarra o cualquier mercancía a granel que no puede descargarse de otra forma. Requiere formación específica para evitar averías graves en el sistema hidráulico." }}
      ]
    })} />
  )}
  {post.id === "2026-02-02-tarjetas-gasoil-profesionales-ahorro-control-flota" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Qué es una tarjeta de gasoil profesional y para qué sirve?",
          "acceptedAnswer": { "@type": "Answer", "text": "Una tarjeta de gasoil profesional es un instrumento de pago específico para combustible y servicios de carretera (peajes, lavados, adblue) que ofrece descuentos por volumen, control de gasto por vehículo o conductor, y facturación unificada para facilitar la deducción del IVA y el IRPF. Está diseñada para autónomos, PYMES y flotas de transporte." }},
        { "@type": "Question", "name": "¿Cuánto ahorro puede conseguir un transportista con una tarjeta de gasoil profesional?",
          "acceptedAnswer": { "@type": "Answer", "text": "El ahorro medio oscila entre 3 y 8 céntimos por litro según la tarjeta, el volumen mensual y la red de gasolineras utilizadas. Para un camión con consumo de 35 L/100km y 10.000 km mensuales (3.500 L/mes), un descuento de 5 ct/L supone un ahorro de 175€/mes, o más de 2.000€ anuales por vehículo." }},
        { "@type": "Question", "name": "¿Qué tarjeta de gasoil profesional tiene más red de gasolineras en España?",
          "acceptedAnswer": { "@type": "Answer", "text": "Repsol tiene la mayor red propia en España con más de 3.500 estaciones. DKV destaca por su cobertura europea y la posibilidad de pagar peajes en varios países. GALP ofrece una buena cobertura en la Península Ibérica incluyendo Portugal. BP tiene red propia más limitada pero con descuentos competitivos en sus estaciones. La elección óptima depende de las rutas habituales de cada flota." }}
      ]
    })} />
  )}
  {post.id === "2026-02-03-infracciones-multas-tacografo" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Cuánto es la multa por no llevar el tacógrafo en regla?",
          "acceptedAnswer": { "@type": "Answer", "text": "Depende de la gravedad. Las infracciones leves van de 100€ a 400€, las graves de 401€ a 2.000€ y las muy graves de 2.001€ a 6.000€. La manipulación del tacógrafo tiene una sanción fija aproximada de 4.001€ y puede conllevar la pérdida de la honorabilidad de la empresa." }},
        { "@type": "Question", "name": "¿Qué es una infracción muy grave del tacógrafo y qué consecuencias tiene?",
          "acceptedAnswer": { "@type": "Answer", "text": "Son infracciones muy graves: manipular el sistema, conducir sin tarjeta o con tarjeta ajena, superar el 50% del tiempo máximo de conducción (más de 13,5h) y negarse a facilitar datos al inspector. Además de la multa económica, restan puntos de honorabilidad, que es el requisito legal para mantener la licencia de transporte." }},
        { "@type": "Question", "name": "¿Cuántos días de registros del tacógrafo puede pedir la Guardia Civil en una inspección?",
          "acceptedAnswer": { "@type": "Answer", "text": "Desde el 1 de enero de 2025, la Guardia Civil puede exigir los registros de los últimos 56 días en una inspección en carretera. Esto incluye los datos de la tarjeta del conductor y de la unidad del vehículo. No tenerlos disponibles se considera infracción grave." }}
      ]
    })} />
  )}
  {post.id === "2026-02-03-tiempos-conduccion-descanso" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Cuántas horas seguidas puede conducir un camionero?",
          "acceptedAnswer": { "@type": "Answer", "text": "El límite diario de conducción es de 9 horas, ampliable a 10 horas un máximo de 2 veces por semana. Tras 4,5 horas de conducción continuada es obligatorio hacer una pausa de al menos 45 minutos (o dos pausas de 15 y 30 minutos en ese orden)." }},
        { "@type": "Question", "name": "¿Cuándo se puede reducir el descanso diario a 9 horas?",
          "acceptedAnswer": { "@type": "Answer", "text": "El descanso diario normal es de 11 horas consecutivas. Se puede reducir a 9 horas (descanso reducido) un máximo de 3 veces entre dos descansos semanales. No requiere compensación posterior, pero debe quedar correctamente registrado en el tacógrafo." }},
        { "@type": "Question", "name": "¿Qué pasa si no hago la pausa de 45 minutos en el tacógrafo?",
          "acceptedAnswer": { "@type": "Answer", "text": "No respetar la pausa obligatoria de 45 minutos tras 4,5 horas de conducción es una infracción grave que puede suponer una multa de entre 401€ y 2.000€. Además, queda registrado en el tacógrafo y es visible en cualquier inspección de los últimos 56 días." }}
      ]
    })} />
  )}
  {post.id === "2026-02-03-que-es-el-tacografo" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Qué vehículos están obligados a llevar tacógrafo?",
          "acceptedAnswer": { "@type": "Answer", "text": "Están obligados a llevar tacógrafo todos los vehículos de transporte de mercancías con una masa máxima autorizada superior a 3,5 toneladas y los vehículos de transporte de viajeros con más de 9 plazas (incluido el conductor), cuando se usen para transporte profesional por carretera." }},
        { "@type": "Question", "name": "¿Cuál es la diferencia entre el tacógrafo digital y el tacógrafo inteligente G2V2?",
          "acceptedAnswer": { "@type": "Answer", "text": "El tacógrafo digital registra tiempos y velocidades en una tarjeta de conductor. El tacógrafo inteligente G2V2 añade posicionamiento GNSS (GPS) automático, comunicación DSRC con los controles de tráfico sin necesidad de parar el vehículo, y registro automático de cruces de frontera. Es obligatorio en nuevos vehículos y en transporte internacional." }},
        { "@type": "Question", "name": "¿Qué pasa si el tacógrafo se estropea durante la ruta?",
          "acceptedAnswer": { "@type": "Answer", "text": "Si el tacógrafo falla en ruta, el conductor debe anotar manualmente sus actividades en hojas de registro manual o en el reverso de los tickets impresos. Debe acudir a un taller autorizado para la reparación en un plazo máximo de 7 días desde el regreso a la base. Continuar sin registros equivale a una infracción muy grave." }}
      ]
    })} />
  )}
  {post.id === "2026-02-06-articulo-12-escudo-legal-excesos-conduccion" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Cuándo se puede aplicar el Artículo 12 del Reglamento 561/2006?",
          "acceptedAnswer": { "@type": "Answer", "text": "El Artículo 12 permite superar los límites de conducción únicamente cuando sea necesario para garantizar la seguridad de personas, vehículo o carga, y para llegar a un punto de parada adecuado. La causa debe ser imprevista: un accidente en la vía, cierre de puerto por nieve o parking lleno. Una mala planificación de ruta no es válida." }},
        { "@type": "Question", "name": "¿Cómo se hace la anotación manual del Artículo 12 en el tacógrafo?",
          "acceptedAnswer": { "@type": "Answer", "text": "Al llegar al punto de parada: imprime un ticket del tacógrafo digital. En el reverso escribe 'Invoco Art. 12 Reg. 561/2006', el motivo concreto (ej: 'Retención por accidente A-1 km 142'), la hora y tu firma. Guarda el ticket durante los próximos 56 días. Sin esta anotación firmada, el exceso es sancionable." }},
        { "@type": "Question", "name": "¿Una retención de tráfico justifica el Artículo 12?",
          "acceptedAnswer": { "@type": "Answer", "text": "Sí, si es imprevista y te impide llegar a un área de descanso a tiempo. Una retención por accidente o corte de carretera es válida. Sin embargo, el inspector puede pedir pruebas externas: informe de la DGT, nota de tráfico o captura del GPS con la retención. La retención por obras programadas o tráfico denso habitual no suele aceptarse." }}
      ]
    })} />
  )}
  {post.id === "2026-02-06-de-28-a-56-dias-cambio-multas-2026" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Cuántos días de registros del tacógrafo debo llevar en el camión?",
          "acceptedAnswer": { "@type": "Answer", "text": "Desde 2025 debes llevar contigo los registros del día en curso más los 56 días anteriores. Esto incluye los datos de tu tarjeta de conductor y, para el jefe de tráfico, también los de la unidad del vehículo. Es obligatorio presentarlos cuando lo solicite un agente de inspección." }},
        { "@type": "Question", "name": "¿Qué son las fechas en blanco en el tacógrafo y por qué son sancionables?",
          "acceptedAnswer": { "@type": "Answer", "text": "Las fechas en blanco son días sin actividad registrada en el tacógrafo que no están justificados con descanso o con el Certificado de Actividades del conductor. Si hay varios días consecutivos sin datos y sin documentación que lo explique, el inspector lo interpreta como falta de registros obligatorios, lo que puede derivar en una infracción grave." }},
        { "@type": "Question", "name": "¿Qué es el DSRC del tacógrafo y cómo funciona?",
          "acceptedAnswer": { "@type": "Answer", "text": "El DSRC (Dedicated Short-Range Communication) es la tecnología del tacógrafo G2V2 que permite a los equipos de inspección leer datos básicos del tacógrafo mientras el vehículo circula a velocidad normal, sin necesidad de parar. Si detectan anomalías, coordinan con patrullas más adelante para interceptar el vehículo y solicitar la documentación completa." }}
      ]
    })} />
  )}
  {post.id === "2026-02-03-tacografo-inteligente-g2v2" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Cuándo es obligatorio instalar el tacógrafo inteligente G2V2?",
          "acceptedAnswer": { "@type": "Answer", "text": "El G2V2 es obligatorio desde agosto de 2023 para los vehículos nuevos matriculados. Los vehículos ya en circulación con tacógrafo digital de primera generación deben hacer el retrofit (actualización) para el transporte internacional. Consulta los plazos específicos según la fecha de primera matriculación de tu vehículo, ya que varían." }},
        { "@type": "Question", "name": "¿Qué diferencia hay entre el tacógrafo G1 y el G2V2?",
          "acceptedAnswer": { "@type": "Answer", "text": "El tacógrafo G1 (digital de primera generación) registra tiempos y velocidades pero requiere inspecciones físicas para leer los datos. El G2V2 añade tres funciones clave: posicionamiento GNSS automático, comunicación DSRC para inspecciones remotas sin parar el vehículo, y registro automático de cruces de frontera internacional." }},
        { "@type": "Question", "name": "¿Qué multa hay por circular en transporte internacional sin el tacógrafo G2V2 obligatorio?",
          "acceptedAnswer": { "@type": "Answer", "text": "Circular en transporte internacional sin el tacógrafo G2V2 cuando es obligatorio se considera infracción muy grave, con sanción aproximada de 4.001€ y posible inmovilización del vehículo en el acto. Además, puede afectar a la honorabilidad de la empresa y poner en riesgo la licencia de transporte internacional." }}
      ]
    })} />
  )}
  {post.id === "2026-02-03-conducir-tarjeta-conductor-caducada" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "¿Es legal conducir con la tarjeta de conductor caducada?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Conducir con la tarjeta de conductor caducada equivale legalmente a conducir sin tarjeta, lo que se tipifica como infracción muy grave. La única excepción es si la tarjeta se ha pedido renovar y han pasado más de 15 días hábiles sin recibirla: en ese caso existe una ventana legal documentada." }},
        { "@type": "Question", "name": "¿Cuánto es la multa por conducir con tarjeta del tacógrafo caducada?",
          "acceptedAnswer": { "@type": "Answer", "text": "La sanción por conducir sin tarjeta válida es una infracción muy grave que puede oscilar entre 2.001€ y 4.001€. Además, puede conllevar la inmovilización del vehículo en el momento de la inspección hasta que se acredite una tarjeta válida o se aplique la excepción legal correspondiente." }},
        { "@type": "Question", "name": "¿Qué debo hacer si me caduca la tarjeta de conductor durante la ruta?",
          "acceptedAnswer": { "@type": "Answer", "text": "Si la tarjeta caduca durante la ruta, debes anotar manualmente tus tiempos de actividad en el reverso de los tickets del tacógrafo o en hojas de registro manual. Debes además acreditar que solicitaste la renovación antes de la fecha de vencimiento. Contacta con tu empresa o gestoría de inmediato para gestionar la documentación." }}
      ]
    })} />
  )}
  {post.id === "2026-02-03-interpretar-ticket-tacografo" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué hora aparece en el ticket del tacógrafo, la local o la UTC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El ticket del tacógrafo siempre muestra la hora UTC (tiempo universal coordinado), no la hora local. En España esto supone 1 hora de diferencia en invierno y 2 horas en verano. Confundirlas ante un inspector es un error frecuente que puede derivar en sanciones por registros incorrectos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué significa el símbolo ! o X en un ticket de tacógrafo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El símbolo ! indica un incidente registrado y la X señala un fallo del sistema. Ambos son lo primero que revisa el inspector: debes tener una justificación documentada, un informe de taller o la anotación manual firmada en el reverso del ticket. Sin esa prueba, el inspector puede levantar acta de infracción."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es obligatorio llevar papel de repuesto para el tacógrafo en el camión?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. La normativa exige llevar siempre rollos de papel homologados de repuesto en el vehículo. No poder imprimir el ticket cuando lo solicita un inspector es una infracción leve. Si además hay otros incumplimientos, la sanción puede escalarse. Usa solo papel homologado: el papel no homologado puede borrarse con el calor."
          }
        }
      ]
    })} />
  )}
  {post.id === "2026-02-03-pictogramas-tacografo" && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué significa el símbolo de la llave en el tacógrafo digital?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El símbolo de la llave indica que el tacógrafo requiere calibración o revisión técnica en un taller autorizado. Es obligatorio acudir al taller antes de continuar operando: ignorarlo puede derivar en una infracción grave por tacógrafo defectuoso o descalibrado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hacer si aparece un símbolo de error en el tacógrafo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Imprime un ticket del tacógrafo en cuanto puedas y anota el tipo de error en el reverso. Si el error afecta al sensor de movimiento, a la alimentación eléctrica o al GNSS, acude a un taller autorizado antes de continuar la ruta. No ignorar el aviso evita sanciones por equipo defectuoso."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuándo es obligatorio revisar el tacógrafo digital?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La revisión técnica del tacógrafo es obligatoria cada 2 años en taller autorizado, o cuando el vehículo supere los 100.000 km entre revisiones. También es obligatoria tras cualquier avería grave, después de una manipulación del equipo o cuando aparezca el símbolo de calibración en pantalla."
          }
        }
      ]
    })} />
  )}
  <!-- BreadcrumbList schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://admilogistic.es/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://admilogistic.es/categorias/" },
      ...(post.data.category ? [{
        "@type": "ListItem",
        "position": 3,
        "name": categoryLabel[post.data.category] ?? post.data.category,
        "item": `https://admilogistic.es/categorias/${post.data.category}/`
      }, {
        "@type": "ListItem",
        "position": 4,
        "name": post.data.title,
