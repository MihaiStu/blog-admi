---
import BaseLayout from '../../layouts/BaseLayout.astro';

const documentos = [
  {
    num: 1,
    titulo: "Checklist de Cabina",
    subtitulo: "Operación Cero Multas",
    descripcion: "Lista de verificación pre-ruta de 2 minutos. Tarjeta, tacógrafo, vehículo.",
    url: "/kit/checklist-cabina",
    icon: "📋",
    color: "#2563eb"
  },
  {
    num: 2,
    titulo: "Guía de Tiempos",
    subtitulo: "Conducción y Descanso",
    descripcion: "Esquema visual del Reg. 561/2006. Límites diarios, semanales y pausas.",
    url: "/kit/guia-tiempos",
    icon: "⏱️",
    color: "#22c55e"
  },
  {
    num: 3,
    titulo: "Protocolo Art. 12",
    subtitulo: "Emergencias",
    descripcion: "Cómo justificar excesos por fuerza mayor. Plantilla de texto incluida.",
    url: "/kit/protocolo-emergencia",
    icon: "🚨",
    color: "#dc2626"
  },
  {
    num: 4,
    titulo: "Planificador Mantenimiento",
    subtitulo: "Control de Flota",
    descripcion: "Tabla de seguimiento de vehículos. ITV, tacógrafo, revisiones.",
    url: "/kit/planificador-mantenimiento",
    icon: "🔧",
    color: "#8b5cf6"
  }
];
---

<BaseLayout pageBg="categorias" title="Kit de Supervivencia del Transportista 2026 - Documentos" description="Accede a los 4 documentos del Kit: Checklist, Guía de Tiempos, Protocolo Art. 12 y Planificador de Mantenimiento.">

  <div class="kit-index">
    <header class="kit-header">
      <span class="kit-badge">KIT 2026</span>
      <h1>Kit de Supervivencia del Transportista</h1>
      <p>4 documentos profesionales listos para imprimir o guardar como PDF. Haz clic en cada documento para abrirlo.</p>
    </header>

    <div class="docs-grid">
      {documentos.map((doc) => (
        <a href={doc.url} class="doc-card" style={`--accent-color: ${doc.color}`}>
          <div class="doc-number">{doc.num}</div>
          <div class="doc-icon">{doc.icon}</div>
          <div class="doc-content">
            <h2>{doc.titulo}</h2>
            <span class="doc-subtitulo">{doc.subtitulo}</span>
            <p>{doc.descripcion}</p>
          </div>
          <div class="doc-action">
            <span>Abrir documento</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="kit-instructions">
      <h3>¿Cómo guardar como PDF?</h3>
      <div class="instructions-grid">
        <div class="instruction">
          <span class="instruction-num">1</span>
          <p>Abre el documento que quieras guardar</p>
        </div>
        <div class="instruction">
          <span class="instruction-num">2</span>
          <p>Haz clic en "Imprimir / Guardar PDF"</p>
        </div>
        <div class="instruction">
          <span class="instruction-num">3</span>
          <p>Selecciona "Guardar como PDF" en destino</p>
        </div>
        <div class="instruction">
          <span class="instruction-num">4</span>
          <p>¡Listo! Ya tienes tu documento</p>
        </div>
      </div>
    </div>

    <div class="kit-cta">
      <p>¿Aún no tienes el Kit completo? Déjanos tu email y te lo enviamos.</p>
      <a href="/descargables" class="cta-btn">Ir a Descargables</a>
    </div>
  </div>
</BaseLayout>

<script>
  // Show welcome message if coming from form
  if (typeof window !== 'undefined') {
    const urlParams = new URLSearchParams(window.location.search);
    const isWelcome = urlParams.get('welcome') === 'true';
    const nombre = localStorage.getItem('kit_nombre');

    if (isWelcome && nombre) {
      const header = document.querySelector('.kit-header');
      if (header) {
        const welcomeDiv = document.createElement('div');
        welcomeDiv.className = 'welcome-banner';
        welcomeDiv.innerHTML = `
          <div class="welcome-content">
            <span class="welcome-icon">🎉</span>
            <div>
              <strong>¡Bienvenido/a, ${nombre}!</strong>
              <p>Ya tienes acceso completo al Kit de Supervivencia. Guarda esta página en favoritos.</p>
            </div>
          </div>
        `;
        header.insertAdjacentElement('afterend', welcomeDiv);

        // Clean URL
        window.history.replaceState({}, '', '/kit/');
      }
    }
  }
</script>

<style>
  .welcome-banner {
    background: linear-gradient(135deg, #22c55e, #16a34a);
    border-radius: 12px;
    padding: 1rem 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 8px 25px rgba(34, 197, 94, 0.3);
  }

  .welcome-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: #fff;
  }

  .welcome-icon {
    font-size: 2rem;
  }

  .welcome-content strong {
    display: block;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }

  .welcome-content p {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.95;
  }

  @media (max-width: 480px) {
    .welcome-banner {
      padding: 1rem;
    }
    .welcome-icon {
      font-size: 1.5rem;
    }
    .welcome-content strong {
      font-size: 1rem;
    }
  }

  .kit-index {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .kit-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .kit-badge {
    display: inline-block;
    background: linear-gradient(135deg, #ff6b35, #f59e0b);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.375rem 1rem;
    border-radius: 20px;
    margin-bottom: 1rem;
    letter-spacing: 1px;
  }

  .kit-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: #fff;
    margin: 0 0 0.75rem 0;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
  }

  .kit-header p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.0625rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Documents Grid */
  .docs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .doc-card {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 16px;
    padding: 1.75rem;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .doc-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--accent-color);
  }

  .doc-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
    border-color: var(--accent-color);
  }

  .doc-number {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 32px;
    height: 32px;
    background: var(--accent-color);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .doc-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .doc-content h2 {
    font-size: 1.25rem;
    color: #1e293b;
    margin: 0 0 0.25rem 0;
  }

  .doc-subtitulo {
    display: block;
    font-size: 0.875rem;
    color: var(--accent-color);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .doc-content p {
    color: #64748b;
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
  }

  .doc-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    color: var(--accent-color);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .doc-card:hover .doc-action svg {
    transform: translateX(4px);
  }

  .doc-action svg {
    transition: transform 0.2s ease;
  }

  /* Instructions */
  .kit-instructions {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(12px);
    border-radius: 16px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .kit-instructions h3 {
    font-size: 1.125rem;
    color: #1e293b;
    margin: 0 0 1.5rem 0;
    text-align: center;
  }

  .instructions-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .instruction {
    text-align: center;
  }

  .instruction-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: #2563eb;
    color: #fff;
    font-weight: 700;
    border-radius: 50%;
    margin: 0 auto 0.75rem;
  }

  .instruction p {
    font-size: 0.8125rem;
    color: #475569;
    margin: 0;
    line-height: 1.4;
  }

  /* CTA */
  .kit-cta {
    text-align: center;
    padding: 2rem;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(139, 92, 246, 0.15));
    border-radius: 16px;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  .kit-cta p {
    color: #fff;
    font-size: 1rem;
    margin: 0 0 1rem 0;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
  }

  .cta-btn {
    display: inline-block;
    background: linear-gradient(135deg, #ff6b35, #f59e0b);
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.875rem 2rem;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 107, 53, 0.4);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .docs-grid {
      grid-template-columns: 1fr;
    }

    .instructions-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .doc-card {
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .kit-index {
      padding: 1rem 0.5rem 2rem;
    }

    .kit-header h1 {
      font-size: 1.5rem;
    }

    .instructions-grid {
      grid-template-columns: 1fr;
    }

    .kit-instructions,
    .kit-cta {
      padding: 1.5rem;
    }
  }
</style>
