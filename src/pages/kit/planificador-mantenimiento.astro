    <!-- Maintenance intervals -->
    <div class="intervals-section">
      <h3 class="intervals-title">📅 Intervalos de Mantenimiento Recomendados</h3>
      <table class="intervals-table">
        <thead>
          <tr>
            <th>Elemento</th>
            <th>Intervalo</th>
            <th>Observaciones</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Aceite motor</td>
            <td class="interval-value">30.000 - 50.000 km</td>
            <td>Según fabricante y tipo de aceite</td>
          </tr>
          <tr>
            <td>Filtro de aire</td>
            <td class="interval-value">40.000 - 60.000 km</td>
            <td>Más frecuente en entornos polvorientos</td>
          </tr>
          <tr>
            <td>Filtro de combustible</td>
            <td class="interval-value">60.000 - 90.000 km</td>
            <td>Crítico para sistemas common rail</td>
          </tr>
          <tr>
            <td>Pastillas de freno</td>
            <td class="interval-value">80.000 - 150.000 km</td>
            <td>Revisar espesor cada 30.000 km</td>
          </tr>
          <tr>
            <td>Calibración tacógrafo</td>
            <td class="interval-value">2 años</td>
            <td>Obligatorio por ley (Reg. 165/2014)</td>
          </tr>
          <tr>
            <td>ITV</td>
            <td class="interval-value">Anual</td>
            <td>Vehículos > 3.500 kg</td>
          </tr>
        </tbody>
      </table>
