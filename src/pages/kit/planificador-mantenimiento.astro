  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Montserrat', sans-serif;
      background: #f8fafc;
      color: #1e293b;
      line-height: 1.5;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      background: #fff;
      padding: 15mm 12mm;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    @media print {
      body { background: #fff; }
      .page {
        width: 100%;
        min-height: auto;
        margin: 0;
        padding: 10mm;
        box-shadow: none;
      }
      .no-print { display: none !important; }
    }

    /* Header */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 10px;
      border-bottom: 3px solid #2563eb;
      margin-bottom: 14px;
    }

    .logo {
      font-size: 18px;
      font-weight: 800;
      color: #1e293b;
    }

    .logo span { color: #2563eb; }

    .year-badge {
      background: linear-gradient(135deg, #ff6b35, #f59e0b);
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
    }

    /* Title */
    .title-section {
      text-align: center;
      margin-bottom: 16px;
    }

    .title-section h1 {
      font-size: 20px;
      font-weight: 800;
      color: #1e293b;
      margin-bottom: 4px;
    }

    .title-section h1 span { color: #2563eb; }

    .subtitle {
      font-size: 10px;
      color: #64748b;
    }

    /* Company info */
    .company-info {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 16px;
      padding: 12px;
      background: #f8fafc;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
    }

    .info-field {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .info-label {
      font-size: 9px;
      color: #64748b;
      text-transform: uppercase;
      font-weight: 600;
    }

    .info-input {
      border-bottom: 1px solid #cbd5e1;
      min-height: 20px;
      font-size: 11px;
    }

    /* Main table */
    .table-section {
      margin-bottom: 16px;
    }

    .table-title {
      font-size: 13px;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .fleet-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
    }

    .fleet-table th {
      background: #1e293b;
      color: #fff;
      padding: 8px 6px;
      text-align: center;
      font-weight: 600;
      font-size: 8px;
      text-transform: uppercase;
    }

    .fleet-table th:first-child {
      border-radius: 8px 0 0 0;
    }

    .fleet-table th:last-child {
      border-radius: 0 8px 0 0;
    }

    .fleet-table td {
      padding: 10px 6px;
      text-align: center;
      border-bottom: 1px solid #e2e8f0;
      min-height: 35px;
    }

    .fleet-table tr:nth-child(even) {
      background: #f8fafc;
    }

    .fleet-table tr:last-child td:first-child {
      border-radius: 0 0 0 8px;
    }

    .fleet-table tr:last-child td:last-child {
      border-radius: 0 0 8px 0;
    }

    /* Status indicators */
    .status-cell {
      display: flex;
      justify-content: center;
      gap: 4px;
    }

    .status-dot {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      border: 2px solid;
    }

    .status-green {
      background: #dcfce7;
      border-color: #22c55e;
    }

    .status-yellow {
      background: #fef3c7;
      border-color: #f59e0b;
    }

    .status-red {
      background: #fee2e2;
      border-color: #ef4444;
    }

    /* Legend */
    .legend {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-bottom: 16px;
      padding: 10px;
      background: #f1f5f9;
      border-radius: 8px;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 9px;
      color: #475569;
    }

    .legend-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
    }

    .legend-dot.green { background: #22c55e; }
    .legend-dot.yellow { background: #f59e0b; }
    .legend-dot.red { background: #ef4444; }

    /* Reminders section */
    .reminders-section {
      margin-bottom: 16px;
    }

    .reminders-title {
      font-size: 13px;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .reminders-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .reminder-card {
      background: #f8fafc;
      border-radius: 10px;
      padding: 12px;
      border: 1px solid #e2e8f0;
    }

    .reminder-card.alert {
      background: #fef2f2;
      border-color: #fca5a5;
    }

    .reminder-icon {
      font-size: 20px;
      margin-bottom: 6px;
    }

    .reminder-card h4 {
      font-size: 10px;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 4px;
    }

    .reminder-card p {
      font-size: 9px;
      color: #64748b;
      line-height: 1.4;
    }

    .reminder-card.alert h4 {
      color: #b91c1c;
    }

    .reminder-card.alert p {
      color: #7f1d1d;
    }

    /* Intervals table */
    .intervals-section {
      margin-bottom: 16px;
    }

    .intervals-title {
      font-size: 12px;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 8px;
    }

    .intervals-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9px;
    }

    .intervals-table th {
      background: #e0e7ff;
      color: #3730a3;
      padding: 6px 8px;
      text-align: left;
      font-weight: 600;
    }

    .intervals-table td {
      padding: 6px 8px;
      border-bottom: 1px solid #e2e8f0;
    }

    .intervals-table tr:nth-child(even) {
      background: #f8fafc;
    }

    .interval-value {
      font-weight: 700;
      color: #1e293b;
    }

    /* Notes section */
    .notes-section {
      background: #fffbeb;
      border: 1px solid #fcd34d;
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 14px;
    }

    .notes-title {
      font-size: 11px;
      font-weight: 700;
      color: #92400e;
      margin-bottom: 8px;
    }

    .notes-lines {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .note-line {
      border-bottom: 1px solid #fcd34d;
      min-height: 18px;
    }

    /* Footer */
    .footer {
      padding-top: 10px;
      border-top: 2px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .footer-left {
      font-size: 8px;
      color: #94a3b8;
    }

    .footer-logo {
      font-size: 10px;
      font-weight: 700;
      color: #64748b;
    }

    .footer-logo span { color: #2563eb; }

    /* Print button */
    .print-btn {
      position: fixed;
      bottom: 30px;
      right: 30px;
      background: #2563eb;
      color: #fff;
      border: none;
      padding: 14px 24px;
      border-radius: 10px;
      font-family: inherit;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
    }

    .print-btn:hover {
      transform: translateY(-2px);
    }
  </style>
</head>
