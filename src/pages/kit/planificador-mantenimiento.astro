    <!-- Legend -->
    <div class="legend">
      <div class="legend-item">
        <div class="legend-dot green"></div>
        <span>OK - Sin acción</span>
      </div>
      <div class="legend-item">
        <div class="legend-dot yellow"></div>
        <span>Atención - Revisar pronto</span>
      </div>
      <div class="legend-item">
        <div class="legend-dot red"></div>
        <span>Urgente - Acción inmediata</span>
      </div>
    </div>

    <!-- Strategic reminders -->
    <div class="reminders-section">
      <h2 class="reminders-title">⚙️ Recordatorios Estratégicos</h2>
      <div class="reminders-grid">
        <div class="reminder-card alert">
          <div class="reminder-icon">📟</div>
          <h4>Tacógrafo G2V2</h4>
          <p>Verificar calibración y sellos de seguridad cada 2 años. Control remoto activo.</p>
        </div>
        <div class="reminder-card">
          <div class="reminder-icon">🛢️</div>
          <h4>Filtros y Fluidos</h4>
          <p>No exceder intervalos del fabricante. Protege el motor y evita averías costosas.</p>
        </div>
        <div class="reminder-card">
          <div class="reminder-icon">🛑</div>
          <h4>Seguridad Activa</h4>
          <p>Sistema de frenado y ABS: revisión cada 30.000 km o según fabricante.</p>
        </div>
      </div>
