---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articulos = (await getCollection('blog', ({ data }) => data.category === 'tarjetas-gasoil'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout pageBg="categorias" title="Tarjetas de Gasoil Profesional - Blog AdmiLogistic" description="Comparativas de tarjetas de combustible: Repsol, Galp, BP, DKV. Descuentos, zonas y casos reales">

  <!-- BLOQUE 1: Marcas de tarjetas -->
  <div class="marcas-container">
    <header class="tarjetas-header">
      <h1>Tarjetas de Gasoil Profesional</h1>
      <p class="tarjetas-intro">Comparativas detalladas de tarjetas de combustible para transportistas profesionales. Descuentos reales, red de estaciones, condiciones comerciales y casos de uso.</p>
    </header>

    <section class="tarjetas-grid">
      <a href="/blog/2026-02-02-tarjeta-gasoil-profesional-repsol" class="tarjeta-card">
        <h2>Repsol Profesional</h2>
        <p>Análisis completo de la tarjeta Repsol para flotas profesionales. Descuentos por volumen, red de estaciones y ventajas comerciales.</p>
      </a>

      <a href="/blog/2026-02-02-tarjeta-gasoil-profesional-galp" class="tarjeta-card">
        <h2>Galp Frota</h2>
        <p>Tarjeta Galp para gestión de flotas. Cobertura peninsular, descuentos y servicios adicionales para transportistas.</p>
      </a>

      <a href="/blog/2026-02-02-tarjeta-gasoil-profesional-bp" class="tarjeta-card">
        <h2>BP Profesional</h2>
        <p>Tarjeta BP para transporte profesional. Descuentos por volumen, control de gasto y facturación detallada.</p>
      </a>

      <a href="/blog/2026-02-02-tarjeta-gasoil-profesional-dkv" class="tarjeta-card">
        <h2>DKV Card</h2>
        <p>Tarjeta multimarca para transporte internacional. Amplia red europea, peajes y servicios complementarios.</p>
      </a>
    </section>
  </div>

  <!-- BLOQUE 2: Artículos/Reportajes -->
  <div class="articulos-container">
    <section class="articulos-section">
      <h2>Artículos y Reportajes</h2>
      {articulos.length === 0 ? (
        <p class="no-articulos">Próximamente publicaremos análisis detallados y comparativas.</p>
      ) : (
        <div class="articulos-grid">
          {articulos.map((entry) => (
            <a href={`/blog/${entry.id}`} class="articulo-card">
              {entry.data.image && (
                <div class="articulo-image">
                  <img src={entry.data.image} alt={entry.data.title} loading="lazy" />
                </div>
              )}
              <div class="articulo-content">
                <h3>{entry.data.title}</h3>
                {entry.data.description && <p>{entry.data.description}</p>}
                <time datetime={entry.data.pubDate.toISOString()}>
                  {entry.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  /* BLOQUE 1: Marcas */
  .marcas-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 3rem;
  }

  .tarjetas-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .tarjetas-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #ffffff;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  }

  .tarjetas-intro {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .tarjetas-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .tarjeta-card {
    display: block;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(16px) saturate(1.1);
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.35);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease;
    text-decoration: none;
    position: relative;
  }

  .tarjeta-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
    border-color: rgba(99, 102, 241, 0.5);
  }

  .tarjeta-card h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    color: #ffffff;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  .tarjeta-card p {
    color: #ffffff;
    line-height: 1.6;
    margin: 0;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.4);
  }

  .tarjeta-pending {
    opacity: 0.85;
    cursor: default;
  }

  .tarjeta-pending:hover {
    transform: none;
    border-color: rgba(255,255,255,0.35);
  }

  .coming-soon {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.25rem 0.75rem;
    background: rgba(99, 102, 241, 0.3);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* BLOQUE 2: Artículos */
  .articulos-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 1rem 4rem;
  }

  .articulos-section {
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .articulos-section h2 {
    font-size: 1.75rem;
    margin-bottom: 2rem;
    color: #ffffff;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    text-align: center;
  }

  .no-articulos {
    text-align: center;
    color: rgba(255, 255, 255, 0.8);
    font-style: italic;
  }

  .articulos-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }

  .articulo-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(16px) saturate(1.1);
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.35);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    overflow: hidden;
    text-decoration: none;
    transition: transform .35s ease, box-shadow .35s ease;
  }

  .articulo-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
  }

  .articulo-image {
    width: 100%;
    height: 140px;
    overflow: hidden;
  }

  .articulo-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .articulo-card:hover .articulo-image img {
    transform: scale(1.05);
  }

  .articulo-content {
    padding: 1rem;
  }

  .articulo-content h3 {
    font-size: 1rem;
    margin-bottom: 0.4rem;
    color: #ffffff;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
    line-height: 1.3;
  }

  .articulo-content p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.8rem;
    line-height: 1.4;
    margin-bottom: 0.5rem;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .articulo-content time {
    display: block;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Responsive */
  @media (max-width: 1400px) {
    .articulos-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 1200px) {
    .marcas-container {
      padding: 1.5rem 1rem 2rem;
    }

    .tarjetas-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    .tarjeta-card {
      padding: 1.25rem;
    }

    .tarjeta-card h2 {
      font-size: 1.25rem;
    }

    .tarjeta-card p {
      font-size: 0.875rem;
    }
  }

  @media (max-width: 1024px) {
    .tarjetas-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .articulos-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .articulos-container {
      padding: 0 1rem 3rem;
    }
  }

  @media (max-width: 768px) {
    .marcas-container {
      padding: 1rem 0.75rem 1.5rem;
    }

    .tarjetas-header h1 {
      font-size: 1.75rem;
    }

    .tarjetas-intro {
      font-size: 1rem;
    }

    .tarjetas-grid {
      gap: 1rem;
    }

    .tarjeta-card {
      padding: 1rem;
    }

    .tarjeta-card h2 {
      font-size: 1.125rem;
      margin-bottom: 0.5rem;
    }

    .tarjeta-card p {
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    .articulos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .articulos-container {
      padding: 0 0.75rem 2.5rem;
    }

    .articulos-section h2 {
      font-size: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .tarjetas-header h1 {
      font-size: 1.5rem;
    }

    .tarjetas-header {
      margin-bottom: 1.5rem;
    }

    .tarjetas-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .articulos-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
    .articulo-image { height: 110px; }
  }

  @media (max-width: 480px) {
    .marcas-container {
      padding: 0.75rem 0.5rem 1rem;
    }

    .tarjetas-header h1 {
      font-size: 1.25rem;
    }

    .tarjetas-intro {
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .tarjetas-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .tarjeta-card {
      padding: 0.875rem;
    }

    .tarjeta-card h2 {
      font-size: 1rem;
      margin-bottom: 0.375rem;
    }

    .tarjeta-card p {
      font-size: 0.75rem;
      line-height: 1.4;
    }

    .coming-soon {
      font-size: 0.625rem;
      padding: 0.2rem 0.5rem;
      margin-top: 0.5rem;
    }

    .articulos-container {
      padding: 0 0.5rem 2rem;
    }

    .articulos-section h2 {
      font-size: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .articulo-content {
      padding: 0.75rem;
    }

    .articulo-content h3 {
      font-size: 0.875rem;
    }

    .articulo-content p {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 360px) {
    .tarjetas-grid {
      grid-template-columns: 1fr;
    }

    .tarjeta-card {
      padding: 1rem;
    }

    .tarjeta-card h2 {
      font-size: 1.125rem;
    }

    .tarjeta-card p {
      font-size: 0.8125rem;
    }
  }
</style>
