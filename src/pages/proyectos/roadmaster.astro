---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout pageBg="proyectos" title="RoadMaster - Proyectos - Blog AdmiLogistic" description="Gestión integral para empresas de transporte">
  <div class="project-page">
    <div class="project-page-inner">
      <div class="construction-banner">
        <span class="construction-icon">🚧</span>
        <span>En construcción</span>
      </div>

      <h1>RoadMaster</h1>

      <section class="what-is">
        <h2>¿Qué es RoadMaster?</h2>
        <p>RoadMaster es una solución integral de gestión para empresas de transporte y logística. Proporciona herramientas completas para la administración de flotas, control de tiempos de conducción, gestión de rutas y cumplimiento normativo.</p>
      </section>

      <section class="problem">
        <h2>¿Qué problema resuelve?</h2>
        <ul>
          <li>Gestión centralizada de flotas de vehículos</li>
          <li>Cumplimiento automático de normativas de tacógrafo</li>
          <li>Optimización de rutas y planificación de viajes</li>
          <li>Control de tiempos de conducción y descanso</li>
          <li>Integración con bases de datos de talleres, gasolineras y parkings</li>
          <li>Reportes y análisis para toma de decisiones</li>
        </ul>
      </section>

      <section class="app-preview">
        <h2>Vista previa</h2>
        <div class="preview-placeholder">
          <img src="/images/projects/roadmaster-800.webp" alt="RoadMaster App Preview" width="800" height="600" loading="lazy" />
        </div>
      </section>

      <div class="cta-buttons">
        <span class="btn btn-disabled">Próximamente disponible</span>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-page {
    min-height: 100%;
    padding: 2rem 1rem 4rem;
  }

  .project-page-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .construction-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.3), rgba(245, 158, 11, 0.3));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(251, 191, 36, 0.5);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    margin-bottom: 2rem;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  .construction-icon {
    font-size: 1.25rem;
  }

  .construction-banner span:last-child {
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
  }

  .project-page-inner h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 2rem;
    color: #ffffff;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
    text-align: center;
  }

  .project-page-inner section {
    margin-bottom: 2rem;
  }

  .project-page-inner h2 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    margin-bottom: 1rem;
    color: #ffffff;
    text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.7);
  }

  .project-page-inner p {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.8;
    margin-bottom: 1rem;
    color: #ffffff;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);
  }

  .what-is {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .problem {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .problem ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0 0;
  }

  .problem li {
    padding: 0.6rem 0;
    padding-left: 1.75rem;
    position: relative;
    color: #ffffff;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
    line-height: 1.6;
    font-weight: 500;
  }

  .problem li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #a5b4fc;
    font-weight: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
  }

  .app-preview {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    text-align: center;
  }

  .preview-placeholder {
    margin-top: 1rem;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .preview-placeholder img {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0.85;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: clamp(0.9375rem, 2vw, 1.125rem);
  }

  .btn-disabled {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.7);
    border: 2px solid rgba(255, 255, 255, 0.3);
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    .project-page {
      padding: 1.5rem 0.75rem 3rem;
    }

    .project-page-inner h1 {
      font-size: 1.75rem;
      margin-bottom: 1.5rem;
    }

    .project-page-inner h2 {
      font-size: 1.25rem;
    }

    .what-is,
    .problem,
    .app-preview {
      padding: 1.25rem;
    }

    .construction-banner {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 480px) {
    .project-page {
      padding: 1rem 0.5rem 2rem;
    }

    .project-page-inner h1 {
      font-size: 1.5rem;
    }

    .project-page-inner h2 {
      font-size: 1.125rem;
    }

    .project-page-inner p {
      font-size: 0.9375rem;
    }

    .what-is,
    .problem,
    .app-preview {
      padding: 1rem;
    }

    .problem li {
      font-size: 0.9375rem;
    }
  }
</style>
