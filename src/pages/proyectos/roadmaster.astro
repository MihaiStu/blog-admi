---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout pageBg="proyectos" title="RoadMaster | App de Gestión para Empresas de Transporte por Carretera" description="RoadMaster: gestión integral de flotas, rutas y conductores para empresas de transporte. Bases de datos de talleres, gasolineras, parkings y hoteles para el transportista profesional.">
  <div class="project-page">
    <div class="project-page-inner">
      <h1>RoadMaster</h1>

      <section class="what-is">
        <h2>¿Qué es RoadMaster?</h2>
        <p>RoadMaster es una plataforma web de gestión operativa para empresas de transporte por carretera. Centraliza en un solo sitio todo lo que necesita un gestor de flota: camiones, conductores, rutas, gastos, mantenimientos y documentación.</p>
        <p>Diseñada para empresas pequeñas y medianas que gestionan entre 1 y 50 vehículos y necesitan orden, control y visibilidad sin depender de hojas de cálculo ni papel.</p>
      </section>

      <section class="problem">
        <h2>Lo que incluye</h2>
        <ul>
          <li><strong>Flota y conductores</strong> — ficha completa de cada vehículo y conductor, alertas de documentación próxima a vencer</li>
          <li><strong>Planificador de rutas para camiones</strong> — rutas optimizadas con restricciones reales de peso, altura y mercancías peligrosas (ADR), peajes, gasolineras y áreas de descanso en ruta</li>
          <li><strong>Control de gastos y repostajes</strong> — registro de repostajes con lectura automática de facturas PDF, control de gastos por vehículo</li>
          <li><strong>Mantenimientos</strong> — calendario de revisiones, alertas preventivas y registro de histórico por camión</li>
          <li><strong>Documentación</strong> — almacén centralizado de permisos, seguros, ITV y tarjetas de tacógrafo con avisos de caducidad</li>
          <li><strong>Dashboard operativo</strong> — visión global de la flota en tiempo real con mapa integrado</li>
        </ul>
      </section>

      <section class="pricing-block">
        <div class="pricing-head">
          <span class="pricing-from">Desde</span>
          <span class="pricing-amount">79 €<span class="pricing-period">/mes</span></span>
          <span class="pricing-note">14 días gratis · sin tarjeta · sin permanencia</span>
        </div>
        <a href="/proyectos/#precios" class="pricing-link">Ver todos los planes y precios →</a>
      </section>

      <section class="trust-row">
        <div class="trust-item"><span class="trust-ico">🚚</span> Para flotas de 1 a 50 vehículos</div>
        <div class="trust-item"><span class="trust-ico">🇪🇸</span> Soporte en español</div>
        <div class="trust-item"><span class="trust-ico">🔓</span> Sin permanencia, cancela cuando quieras</div>
        <div class="trust-item"><span class="trust-ico">☁️</span> En la nube, sin instalar nada</div>
      </section>

      <div class="cta-buttons">
        <a href="https://roadmaster.admilogistic.es/register" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Probar gratis 14 días</a>
        <a href="https://roadmaster.admilogistic.es" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">Acceder a la app</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-page {
    min-height: 100%;
    padding: 2rem 1rem 4rem;
  }

  .project-page-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .project-page-inner h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 2rem;
    color: #ffffff;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
    text-align: center;
  }

  .project-page-inner section {
    margin-bottom: 2rem;
  }

  .project-page-inner h2 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    margin-bottom: 1rem;
    color: #ffffff;
    text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.7);
  }

  .project-page-inner p {
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.8;
    margin-bottom: 1rem;
    color: #ffffff;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.6);
  }

  .what-is {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .problem {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .problem ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0 0;
  }

  .problem li {
    padding: 0.6rem 0;
    padding-left: 1.75rem;
    position: relative;
    color: #ffffff;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
    line-height: 1.6;
    font-weight: 500;
  }

  .problem li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #a5b4fc;
    font-weight: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.875rem 2rem;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: clamp(0.9375rem, 2vw, 1.125rem);
  }

  .btn-primary {
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: #ffffff;
    border: 2px solid transparent;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgba(99, 102, 241, 0.55);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.4);
    transition: background 0.2s, border-color 0.2s;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 768px) {
    .project-page {
      padding: 1.5rem 0.75rem 3rem;
    }

    .project-page-inner h1 {
      font-size: 1.75rem;
      margin-bottom: 1.5rem;
    }

    .project-page-inner h2 {
      font-size: 1.25rem;
    }

    .what-is,
    .problem,
    .app-preview {
      padding: 1.25rem;
    }

    .construction-banner {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 480px) {
    .project-page {
      padding: 1rem 0.5rem 2rem;
    }

    .project-page-inner h1 {
      font-size: 1.5rem;
    }

    .project-page-inner h2 {
      font-size: 1.125rem;
    }

    .project-page-inner p {
      font-size: 0.9375rem;
    }

    .what-is,
    .problem,
    .app-preview {
      padding: 1rem;
    }

    .problem li {
      font-size: 0.9375rem;
    }
  }

  /* Precio + confianza */
  .pricing-block {
    max-width: 880px;
    margin: 2rem auto 1rem;
    padding: 1.5rem;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(129, 140, 248, 0.4);
    border-radius: 16px;
    text-align: center;
  }
  .pricing-head { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; }
  .pricing-from { color: rgba(255,255,255,0.7); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .pricing-amount { color: #fff; font-size: 2.6rem; font-weight: 800; line-height: 1; }
  .pricing-period { font-size: 1.1rem; font-weight: 500; color: rgba(255,255,255,0.75); }
  .pricing-note { color: rgba(255,255,255,0.85); font-size: 0.95rem; margin-top: 0.4rem; }
  .pricing-link { display: inline-block; margin-top: 1rem; color: #c7d2fe; font-weight: 600; text-decoration: none; }
  .pricing-link:hover { text-decoration: underline; }

  .trust-row {
    max-width: 880px;
    margin: 0 auto 1.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .trust-item {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 12px;
    padding: 0.9rem 0.75rem;
    text-align: center;
    color: rgba(255,255,255,0.92);
    font-size: 0.85rem;
    line-height: 1.35;
  }
  .trust-ico { display: block; font-size: 1.5rem; margin-bottom: 0.4rem; }
  @media (max-width: 720px) {
    .trust-row { grid-template-columns: repeat(2, 1fr); }
    .pricing-amount { font-size: 2.1rem; }
  }
</style>
