---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout pageBg="proyectos" title="Precios AdmiLogistic | Planes para Transportistas y Flotas desde €49/mes" description="Consulta los planes y precios de AdmiLogistic: gestión de flotas, tacógrafo digital y herramientas de administración para transportistas autónomos y empresas de transporte.">
  <div class="redirect-notice">
    <p>Precios oficiales y FAQ están en la página <strong>Herramientas</strong>.</p>
    <p><a href="/proyectos/#precios">Ir a Herramientas → Precios</a></p>
  </div>
</BaseLayout>
<style>
  .redirect-notice {
    max-width: 480px;
    margin: 4rem auto;
    padding: 2rem;
    text-align: center;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 12px;
    color: #fff;
  }
  .redirect-notice a {
    color: #c7d2fe;
    font-weight: 600;
  }
</style>
