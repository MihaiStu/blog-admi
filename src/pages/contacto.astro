---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  pageBg="categorias"
  title="Contacto | AdmiLogistic"
  description="Contacta con AdmiLogistic para consultas, colaboraciones o sugerencias de contenido sobre transporte y logística profesional en España."
>
  <section class="contact-page">
    <div class="contact-inner">

      <header class="contact-header">
        <h1>Contacto</h1>
        <p>Escríbenos para cualquier consulta, sugerencia de artículo, corrección de contenido o propuesta de colaboración.</p>
      </header>

      <div class="contact-grid">

        <div class="contact-info">
          <div class="info-block">
            <h2>Datos de contacto</h2>
            <ul class="info-list">
              <li>
                <span class="info-label">Empresa</span>
                <span class="info-value">ADMI LOGISTIC SL</span>
              </li>
              <li>
                <span class="info-label">NIF</span>
                <span class="info-value">B22571921</span>
              </li>
              <li>
                <span class="info-label">Email general</span>
                <a href="mailto:info@admilogistic.es" class="info-value info-link">info@admilogistic.es</a>
              </li>
              <li>
                <span class="info-label">Email editorial</span>
                <a href="mailto:contacto@admilogistic.es" class="info-value info-link">contacto@admilogistic.es</a>
              </li>
            </ul>
          </div>

          <div class="info-block">
            <h2>¿Para qué puedes escribirnos?</h2>
            <ul class="reasons-list">
              <li>Proponer un tema o artículo para el blog</li>
              <li>Reportar un error en algún contenido</li>
              <li>Consultas sobre colaboraciones y publicidad</li>
              <li>Solicitar información sobre nuestras herramientas</li>
              <li>Cualquier cuestión relacionada con tus datos personales</li>
            </ul>
          </div>
        </div>

        <div class="contact-form-wrap">
          <h2>Envíanos un mensaje</h2>
          <form
            class="contact-form"
            action="https://formspree.io/f/contacto@admilogistic.es"
            method="POST"
          >
            <div class="form-field">
              <label for="name">Nombre</label>
              <input type="text" id="name" name="name" required placeholder="Tu nombre" autocomplete="name" />
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="tu@email.com" autocomplete="email" />
            </div>
            <div class="form-field">
              <label for="subject">Asunto</label>
              <select id="subject" name="subject">
                <option value="">Selecciona un asunto</option>
                <option value="propuesta-contenido">Propuesta de contenido</option>
                <option value="error-contenido">Reportar un error</option>
                <option value="colaboracion">Colaboración / Publicidad</option>
                <option value="herramientas">Consulta sobre herramientas</option>
                <option value="privacidad">Datos personales / RGPD</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div class="form-field">
              <label for="message">Mensaje</label>
              <textarea id="message" name="message" required rows="5" placeholder="Escribe tu mensaje aquí..."></textarea>
            </div>
            <button type="submit" class="btn-submit">Enviar mensaje</button>
          </form>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding: 3rem 1rem 5rem;
  }

  .contact-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .contact-header {
    margin-bottom: 2.5rem;
  }

  .contact-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    font-weight: 700;
    color: var(--text-primary, #111);
    margin-bottom: 0.5rem;
  }

  .contact-header p {
    font-size: 1.05rem;
    color: #555;
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 700px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .info-block {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.07);
    margin-bottom: 1.25rem;
  }

  .info-block:last-child {
    margin-bottom: 0;
  }

  .info-block h2 {
    font-size: 1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1rem;
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .info-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: #888;
  }

  .info-value {
    font-size: 0.9375rem;
    color: #222;
    font-weight: 500;
  }

  .info-link {
    color: #4f46e5;
    text-decoration: none;
  }

  .info-link:hover {
    text-decoration: underline;
  }

  .reasons-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .reasons-list li {
    font-size: 0.9rem;
    color: #444;
    padding-left: 1.1rem;
    position: relative;
    line-height: 1.5;
  }

  .reasons-list li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: #6366f1;
    font-weight: 900;
  }

  /* Formulario */
  .contact-form-wrap {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 14px;
    padding: 1.75rem 2rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.07);
  }

  .contact-form-wrap h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1.25rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-field label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #333;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    padding: 0.7rem 0.9rem;
    font-size: 0.9375rem;
    border: 1.5px solid #ddd;
    border-radius: 8px;
    background: #fff;
    color: #111;
    transition: border-color 0.2s;
    font-family: inherit;
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn-submit {
    padding: 0.85rem 1.5rem;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
    align-self: flex-start;
  }

  .btn-submit:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
</style>
