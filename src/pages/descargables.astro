    text-align: center;
    box-shadow: 0 20px 60px rgba(255, 87, 34, 0.35);
  }

  .cta-card h2 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    color: var(--color-blanco);
    margin: 0 0 0.75rem 0;
    font-weight: 700;
  }

  .cta-card p {
    color: rgba(255, 255, 255, 0.95);
    font-size: 1.0625rem;
    margin: 0 0 1.75rem 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-boton {
    display: inline-block;
    background: var(--color-blanco);
    color: var(--color-naranja);
    font-size: 1rem;
    font-weight: 700;
