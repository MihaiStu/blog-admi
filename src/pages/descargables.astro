    <!-- ============================================
         BLOQUE 4: CTA FINAL
         ============================================ -->
    <section class="cta-final-section">
      <div class="cta-card">
        <h2>¿Listo para circular sin preocupaciones?</h2>
        <p>Descarga el Kit de Supervivencia y ten siempre la respuesta correcta ante cualquier inspección.</p>
        <a href="#descargar" class="cta-boton">DESCARGAR KIT GRATIS</a>
      </div>
    </section>

  </div>

  <!-- ============================================
       BLOQUE 5: PÁGINA DE GRACIAS (Oculta por defecto)
       Se activa con ?success=true desde Mailrelay
       ============================================ -->
  <div class="gracias-overlay" id="graciasOverlay">
    <div class="gracias-modal">
      <button class="gracias-cerrar" id="cerrarGracias" aria-label="Cerrar">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="gracias-icono">🎉</div>
      <h2>¡Tu Kit está listo!</h2>
      <p>Gracias por confiar en AdmiLogistic. Aquí tienes acceso directo a todos los documentos:</p>

      <div class="descargas-grid">
        <a href="/kit/checklist-cabina" class="descarga-boton" target="_blank">
          <span class="descarga-icono">📋</span>
          <span class="descarga-texto">
            <strong>Checklist de Cabina</strong>
            <small>Verificación Pre-Ruta</small>
          </span>
        </a>
        <a href="/kit/guia-tiempos" class="descarga-boton" target="_blank">
          <span class="descarga-icono">⏱️</span>
          <span class="descarga-texto">
            <strong>Guía de Tiempos</strong>
            <small>Conducción y Descanso</small>
          </span>
        </a>
        <a href="/kit/protocolo-emergencia" class="descarga-boton" target="_blank">
          <span class="descarga-icono">🚨</span>
          <span class="descarga-texto">
            <strong>Protocolo Art. 12</strong>
            <small>Emergencias</small>
          </span>
        </a>
        <a href="/kit/planificador-mantenimiento" class="descarga-boton" target="_blank">
          <span class="descarga-icono">🔧</span>
          <span class="descarga-texto">
            <strong>Planificador</strong>
            <small>Mantenimiento Flota</small>
          </span>
        </a>
      </div>

      <div class="gracias-nota">
        <p><strong>Consejo:</strong> Guarda esta página en favoritos o accede siempre desde <a href="/kit/">admilogistic.es/kit</a></p>
      </div>

      <a href="/kit/" class="gracias-link">Ver todos los documentos del Kit →</a>
    </div>
  </div>

</BaseLayout>

<script data-cfasync="false" type="text/javascript" src="https://assets.ipzmarketing.com/assets/signup_form/iframe_v1.js"></script>

<script>
  // FAQ Accordion
  document.querySelectorAll('.faq-pregunta').forEach(button => {
    button.addEventListener('click', () => {
      const faqItem = button.parentElement;
      const isOpen = button.getAttribute('aria-expanded') === 'true';

      // Cerrar todos los demás
      document.querySelectorAll('.faq-item').forEach(item => {
        item.classList.remove('active');
        item.querySelector('.faq-pregunta')?.setAttribute('aria-expanded', 'false');
      });

      // Abrir/cerrar el actual
      if (!isOpen) {
        faqItem?.classList.add('active');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Página de Gracias - Detectar parámetro success
  if (typeof window !== 'undefined') {
    const urlParams = new URLSearchParams(window.location.search);
    const isSuccess = urlParams.get('success') === 'true' || urlParams.get('welcome') === 'true';

    if (isSuccess) {
      const overlay = document.getElementById('graciasOverlay');
      if (overlay) {
        overlay.classList.add('visible');
        document.body.style.overflow = 'hidden';
      }
      // Limpiar URL
      window.history.replaceState({}, '', '/descargables/');
    }
  }

  // Cerrar modal de gracias
  document.getElementById('cerrarGracias')?.addEventListener('click', () => {
    const overlay = document.getElementById('graciasOverlay');
    if (overlay) {
      overlay.classList.remove('visible');
      document.body.style.overflow = '';
    }
  });

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const overlay = document.getElementById('graciasOverlay');
      if (overlay?.classList.contains('visible')) {
        overlay.classList.remove('visible');
        document.body.style.overflow = '';
      }
    }
  });

  // Smooth scroll para anclas
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href') || '');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>

<style>
  /* ============================================
     VARIABLES Y RESET
     ============================================ */
  :root {
    --color-gris-oscuro: #1e293b;
    --color-gris-medio: #475569;
    --color-gris-claro: #94a3b8;
    --color-azul: #2563eb;
    --color-azul-hover: #1d4ed8;
    --color-naranja: #FF5722;
    --color-naranja-hover: #E64A19;
    --color-verde: #22c55e;
    --color-blanco: #ffffff;
    --color-fondo: #f8fafc;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    --shadow-sm: 0 2px 8px rgba(0,0,0,0.08);
    --shadow-md: 0 8px 24px rgba(0,0,0,0.12);
    --shadow-lg: 0 16px 48px rgba(0,0,0,0.16);
    --shadow-xl: 0 24px 64px rgba(0,0,0,0.2);
  }

  .descargables-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* ============================================
     BLOQUE 1: HERO CAPTACIÓN
     ============================================ */
  .hero-captacion {
    padding: 2rem 0 3rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: start;
  }

  .hero-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--color-verde), #16a34a);
    color: var(--color-blanco);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 25px;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .hero-content h1 {
    font-size: clamp(1.625rem, 4vw, 2.375rem);
    color: var(--color-blanco);
    margin: 0 0 1.25rem 0;
    line-height: 1.2;
    font-weight: 800;
    text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.5);
  }

  .hero-subtitle {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.7;
    margin-bottom: 2rem;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.4);
  }

  /* Lista de Recursos */
  .recursos-lista {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .recurso-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: all 0.3s ease;
  }

  .recurso-item:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: translateX(6px);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .recurso-icon {
    font-size: 1.75rem;
    flex-shrink: 0;
  }

  .recurso-texto strong {
    display: block;
    color: var(--color-blanco);
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 0.125rem;
  }

  .recurso-texto span {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8125rem;
  }

  /* Formulario Card */
  .hero-form-wrapper {
    position: sticky;
    top: 80px;
  }

  .form-card {
    background: rgba(255, 255, 255, 0.97);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .form-header {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .form-header h2 {
    font-size: 1.5rem;
    color: var(--color-gris-oscuro);
    margin: 0 0 0.375rem 0;
    font-weight: 800;
  }

  .form-header p {
    color: var(--color-gris-medio);
    font-size: 0.9375rem;
    margin: 0;
  }

  .form-iframe-container {
    border-radius: var(--radius-md);
    overflow: hidden;
    min-height: 320px;
  }

  .form-iframe-container iframe {
    border: none !important;
    width: 100% !important;
    min-height: 320px;
  }

  .form-nota {
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-gris-claro);
    margin: 1rem 0 0 0;
  }

  /* ============================================
     BLOQUE 2: ESTADÍSTICAS
     ============================================ */
  .stats-section {
    padding: 2rem 0;
    margin-bottom: 2rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .stat-card {
    background: rgba(255, 255, 255, 0.75) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    border-radius: var(--radius-lg) !important;
    padding: 1.5rem 1rem !important;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.4) !important;
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .stat-numero {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #FF5722 !important;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-texto {
    font-size: 0.8125rem;
    color: #475569 !important;
    font-weight: 500;
  }

  /* ============================================
     BLOQUE 3: FAQ ACCORDION
     ============================================ */
  .faq-section {
    padding: 3rem 0;
    margin-bottom: 2rem;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .faq-header h2 {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    color: var(--color-blanco);
    margin: 0 0 0.75rem 0;
    font-weight: 700;
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
  }

  .faq-header p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1rem;
    margin: 0;
  }

  .faq-accordion {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.08) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    border-radius: var(--radius-md) !important;
    overflow: hidden !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    background: rgba(255, 255, 255, 0.12) !important;
    border-color: rgba(255, 255, 255, 0.25) !important;
  }

  .faq-item.active {
    background: rgba(255, 255, 255, 0.15) !important;
    border-color: rgba(255, 255, 255, 0.3) !important;
  }

  .faq-pregunta {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    transition: all 0.2s ease;
  }

  .faq-pregunta:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .faq-numero {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    background: var(--color-azul);
    color: var(--color-blanco);
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .faq-texto {
    flex: 1;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #ffffff !important;
    line-height: 1.4;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.4);
  }

  .faq-icono {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.7);
    transition: transform 0.3s ease;
  }

  .faq-item.active .faq-icono {
    transform: rotate(180deg);
    color: #ffffff;
  }

  .faq-respuesta {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
  }

  .faq-item.active .faq-respuesta {
    max-height: 500px;
  }

  .faq-respuesta p {
    padding: 0 1.25rem 1.25rem 4rem;
    margin: 0;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.85) !important;
    line-height: 1.7;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
  }

  /* ============================================
     BLOQUE 4: CTA FINAL
     ============================================ */
  .cta-final-section {
    padding: 2rem 0 4rem;
  }

  .cta-card {
    background: linear-gradient(135deg, var(--color-naranja) 0%, var(--color-naranja-hover) 100%);
