<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-logo">Blog AdmiLogistic</a>
    <nav>
      <ul class="nav-links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/categorias">Categorías</a></li>
        <li><a href="/bases-datos">Bases de Datos</a></li>
        <li><a href="/proyectos">Proyectos</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Header text + links: higher contrast, stronger shadow for legibility */
  .site-header,
  .site-header a {
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.45);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 9999;
    height: 56px;
    display: flex;
    align-items: center;
    /* Slightly darker and stronger glass to ensure text remains legible */
    background: rgba(0, 0, 0, 0.22);
    background-image: linear-gradient(to bottom, rgba(0,0,0,0.24), rgba(0,0,0,0.08));
    backdrop-filter: blur(12px) saturate(1.18);
    -webkit-backdrop-filter: blur(12px) saturate(1.18);
    border-bottom: 1px solid rgba(255, 255, 255, 0.24);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.10);
  }

  .header-inner {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 24px;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease, opacity 0.15s ease;
  }

  /* Hover state: ensure clear feedback and higher contrast */
  .site-header a:hover {
    color: rgba(255, 255, 255, 0.98);
  }

  @media (max-width: 768px) {
    .header-inner {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.75rem 16px;
    }

    .site-header {
      height: auto;
      min-height: 56px;
    }

    .nav-links {
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-links li {
      margin: 0;
    }

    .nav-links a {
      font-size: 0.9375rem;
      padding: 0.25rem 0;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding: 0.5rem 12px;
    }

    .site-logo {
      font-size: 1rem;
    }

    .nav-links {
      gap: 0.5rem;
    }

    .nav-links a {
      font-size: 0.875rem;
    }
  }
</style>
