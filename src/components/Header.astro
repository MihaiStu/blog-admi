---
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-logo">Blog AdmiLogistic</a>
    <nav>
      <ul class="nav-links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/categorias">Guías y Normativa</a></li>
        <li><a href="/bases-datos">Bases de Datos</a></li>
        <li><a href="/proyectos">Herramientas</a></li>
        <li><a href="/colaboradores">Colaboradores</a></li>
        <li><a href="https://roadmaster.admilogistic.es/register" class="btn-roadmaster" target="_blank" rel="noopener noreferrer">Probar RoadMaster</a></li>
        <li><a href="/descargables" class="btn-descargables">Descargables</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Header text + links: higher contrast, stronger shadow for legibility */
  .site-header,
  .site-header a {
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 3px 6px rgba(0, 0, 0, 0.45);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 9999;
    height: 56px;
    display: flex;
    align-items: center;
    /* Slightly darker and stronger glass to ensure text remains legible */
    background: rgba(0, 0, 0, 0.22);
    background-image: linear-gradient(to bottom, rgba(0,0,0,0.24), rgba(0,0,0,0.08));
    backdrop-filter: blur(12px) saturate(1.18);
    -webkit-backdrop-filter: blur(12px) saturate(1.18);
    border-bottom: 1px solid rgba(255, 255, 255, 0.24);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.10);
  }

  .header-inner {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 24px;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease, opacity 0.15s ease;
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
  }

  /* Hover state: ensure clear feedback and higher contrast */
  .site-header a:hover {
    color: rgba(255, 255, 255, 0.98);
  }

  /* Botón RoadMaster */
  .btn-roadmaster {
    background: linear-gradient(135deg, #6366f1, #4f46e5) !important;
    color: #fff !important;
    padding: 0.5rem 1rem !important;
    min-height: 44px;
    min-width: 44px;
    border-radius: 8px !important;
    font-weight: 600 !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3) !important;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35) !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .btn-roadmaster:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 18px rgba(99, 102, 241, 0.5) !important;
  }

  /* Botón destacado Descargables */
  .btn-descargables {
    background: linear-gradient(135deg, #ff6b35, #f7931e) !important;
    color: #fff !important;
    padding: 0.5rem 1rem !important;
    min-height: 44px;
    min-width: 44px;
    border-radius: 8px !important;
    font-weight: 600 !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3) !important;
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.35) !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .btn-descargables:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 18px rgba(255, 107, 53, 0.45) !important;
  }

  @media (max-width: 768px) {
    .header-inner {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.75rem 16px;
    }

    .site-header {
      height: auto;
      min-height: 56px;
    }

    .nav-links {
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-links li {
      margin: 0;
    }

    .nav-links a {
      font-size: 0.9375rem;
      padding: 0.5rem 0.75rem;
      min-height: 44px;
      min-width: 44px;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding: 0.5rem 12px;
    }

    .site-logo {
      font-size: 1rem;
    }

    .nav-links {
      gap: 0.5rem;
    }

    .nav-links a {
      font-size: 0.875rem;
    }
  }
</style>
