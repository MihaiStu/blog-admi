# Copia este archivo a .env y rellena los valores.
# .env no se sube a Git (añádelo a .gitignore si no está).

# ========== Google AdSense ==========
# ID de publicador (lo ves en AdSense → Cuenta → Información de la cuenta).
# Ejemplo: ca-pub-1234567890123456
PUBLIC_ADSENSE_CLIENT=

# IDs de los bloques de anuncios (AdSense → Anuncios → Por unidad de anuncio → Crear).
# Son números, ej: 1234567890. Puedes usar el mismo en ambos o crear dos unidades.
PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=
